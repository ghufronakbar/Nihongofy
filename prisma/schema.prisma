generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // supabase: connection pooling via DATABASE_URL, migrasi via DIRECT_URL
}

// ============================================================
// ENUMS
// ============================================================

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum JlptSection {
  MOJI_GOI // 文字・語彙 (kosakata & kanji)
  BUNPOU // 文法 (tata bahasa)
  DOKKAI // 読解 (membaca)
  CHOUKAI // 聴解 (mendengarkan)
}

// Tipe mondai (問題). Menentukan format render di frontend,
// mis. BUNPOU_SENTENCE_COMPOSITION dirender dengan slot [_] dan [★].
enum MondaiType {
  // --- moji goi (文字・語彙) ---
  MOJI_GOI_READ_KANJI // 漢字読み: cara baca kanji yang digarisbawahi
  MOJI_GOI_WRITE_KANJI // 表記: kanji dari kata hiragana yang digarisbawahi
  MOJI_GOI_WORD_FORMATION // 語形成: pembentukan kata (imbuhan/kata majemuk)
  MOJI_GOI_CONTEXT // 文脈規定: kata yang tepat sesuai konteks kalimat
  MOJI_GOI_SYNONYM // 言い換え類義: sinonim/parafrase kata yang digarisbawahi
  MOJI_GOI_WORD_USAGE // 用法: penggunaan kata yang benar dalam kalimat

  // --- bunpou (文法) ---
  BUNPOU_GRAMMAR // 文法形式の判断: pilih bentuk grammar yang tepat
  BUNPOU_SENTENCE_COMPOSITION // 文の組み立て: susun kalimat, jawaban = posisi ★
  BUNPOU_TEXT_GRAMMAR // 文章の文法: grammar dalam wacana (cloze test)

  // --- dokkai (読解) ---
  DOKKAI_SHORT_TEXT // 内容理解（短文）
  DOKKAI_MEDIUM_TEXT // 内容理解（中文）
  DOKKAI_LONG_TEXT // 内容理解（長文）
  DOKKAI_INTEGRATED // 統合理解: membandingkan 2 teks
  DOKKAI_MAIN_IDEA // 主張理解: memahami klaim/opini penulis
  DOKKAI_INFORMATION_RETRIEVAL // 情報検索: cari info dari pengumuman/brosur

  // --- choukai (聴解) ---
  CHOUKAI_TASK_BASED // 課題理解: apa yang harus dilakukan selanjutnya
  CHOUKAI_MAIN_POINT // ポイント理解: poin penting dari percakapan
  CHOUKAI_OUTLINE // 概要理解: gambaran umum isi audio
  CHOUKAI_EXPRESSION // 発話表現: ungkapan yang tepat untuk situasi (ada gambar)
  CHOUKAI_QUICK_RESPONSE // 即時応答: respon cepat, pilihan hanya audio
  CHOUKAI_INTEGRATED // 統合理解: audio panjang, integrasi informasi
}

enum AttemptStatus {
  IN_PROGRESS // sedang dikerjakan (timer jalan)
  COMPLETED // disubmit, sudah dinilai
  ABANDONED // ditinggal / dibatalkan, tidak masuk analitik
}

// ---- Flashcard (kosakata bawaan, penjadwalan ala Anki) ----

// Deck bawaan dibentuk dari satu tag taxonomy (src/flashcard-data/taxonomy.json).
enum FlashcardDeckKind {
  LEVEL // n5 ... n1
  TOPIC // makanan, pekerjaan, ...
  CATEGORY // onomatope, idiom, ...
}

enum BunpouKind {
  PATTERN
  PARTICLE
  CONJUGATION
  FOUNDATION
}

enum FlashcardCardType {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

// Suspend dan bury sengaja BUKAN nilai queue, melainkan kolom sendiri di
// FlashcardCard, supaya jadwal asli kartu tidak tertimpa saat disembunyikan.
enum FlashcardCardQueue {
  NEW
  LEARNING // learning/relearning yang jatuh tempo hari ini
  DAY_LEARN // learning/relearning yang menyeberang batas hari
  REVIEW
}

enum FlashcardRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum FlashcardRevlogKind {
  LEARN
  REVIEW
  RELEARN
  MANUAL
  RESCHEDULED
}

enum PracticeSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConversationMode {
  TEXT
  VOICE
}

enum ConversationSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ConversationTurnRole {
  USER
  ASSISTANT
}

enum ConversationInputSource {
  TYPED
  SPEECH
}

enum QuestionExplanationSource {
  AI // hasil generate model bahasa, belum tentu dikurasi
  HUMAN // ditulis/diperbaiki manusia
  IMPORTED // berasal dari buku pembahasan resmi
}

enum CommentVisibility {
  PRIVATE // catatan pribadi, hanya terlihat oleh pemiliknya
  PUBLIC // dibagikan ke diskusi, terlihat semua orang termasuk guest
}

// Laporan dari pengguna. Target opsional: satu laporan boleh berdiri sendiri
// (bug aplikasi, saran) atau menempel pada objek yang dikeluhkan.
//
// GENERAL bukan "tanpa nilai", melainkan pilihan eksplisit — dengan begitu
// filter antrean admin tidak perlu menebak dari kolom mana yang non-null.
//
// FLASHCARD_VOCAB menunjuk kata di katalog (FlashcardVocab), bukan kartu milik
// user: isi kartu semua user berasal dari baris katalog yang sama.
enum ReportTargetType {
  GENERAL
  QUESTION
  QUESTION_EXPLANATION
  ARTICLE
  COMMENT
  FLASHCARD_VOCAB
  BUNPOU_POINT
  BUNPOU_COMPARISON
}

// Kategori dibatasi oleh target: peta lengkapnya ada di
// `src/features/report/constants.ts` dan ditegakkan oleh zod, bukan oleh CHECK
// constraint — peta itu yang paling sering berubah, dan mengubahnya lewat
// migrasi setiap kali ada kategori baru adalah gesekan tanpa imbalan.
//
// ANSWER_KEY dipisah dari CONTENT_ERROR karena sudah ada alur untuknya:
// `QuestionExplanation.answerKeyDoubt`. Keduanya antrean yang sama.
//
// READING_ERROR s.d. TAG_ERROR adalah kategori konten kartu kosakata. Masing-
// masing menunjuk bagian fixture yang berbeda, dan bacaan yang keliru perbaikannya
// berbeda dari isi kartu lain (lihat docs/module/report.md). Urutannya mengikuti
// ALTER TYPE ... ADD VALUE, yang selalu menambah di akhir.
enum ReportCategory {
  BUG
  CONTENT_ERROR
  ANSWER_KEY
  MEDIA_ERROR
  EXPLANATION_ERROR
  ABUSE
  SUGGESTION
  OTHER
  READING_ERROR
  MEANING_ERROR
  EXAMPLE_ERROR
  TAG_ERROR
  CONNECTION_ERROR
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
  DUPLICATE
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  EMAIL_CHANGE
  PASSWORD_RESET
}

enum OAuthProvider {
  GOOGLE
}

// Role statis dua level, sengaja tanpa tabel permission granular. Yang dapat
// memperbaiki typo soal juga dapat menghapus akun user; pemisahan peran editor/
// moderator adalah keputusan terpisah bila memang dibutuhkan.
//
// Role TIDAK ikut masuk payload JWT session. Token berlaku 7 hari, sehingga
// demote admin baru berlaku setelah token kedaluwarsa bila dibaca dari sana.
// Sumber kebenarannya adalah kolom di bawah, dibaca per request.
enum UserRole {
  USER
  ADMIN
}

// ============================================================
// USER
// ============================================================

// Username adalah nama publik (handle), BUKAN kredensial: login memakai email
// saja. Dulu kolom ini menjadi identifier login akun legacy — jalur itu sudah
// dihapus supaya handle boleh tampil di komentar dan boleh diganti kapan saja.
model User {
  id                       Int       @id @default(autoincrement())
  username                 String    @unique @db.VarChar(30) // handle publik, selalu lowercase
  displayName              String
  email                    String?   @unique // nullable hanya untuk akun legacy yang belum dibackfill
  emailVerifiedAt          DateTime?
  avatarUrl                String?   @db.Text
  avatarPublicId           String?   @unique @db.VarChar(255)
  avatarFormat             String?   @db.VarChar(10)
  avatarBytes              Int?
  timeZone                 String    @default("Asia/Jakarta") @db.VarChar(100)
  allowAudioStorage        Boolean   @default(false)
  allowConversationStorage Boolean   @default(false)
  deletionRequestedAt      DateTime?
  deletionScheduledFor     DateTime?
  // Penghapusan akun menganonimkan baris ini, tidak menghapusnya. Barisnya harus
  // bertahan supaya thread diskusi yang dibalas orang lain tetap utuh; data
  // pribadi lain (attempt, flashcard, conversation, token, OAuth) tetap dihapus.
  anonymizedAt             DateTime?
  password                 String? // null hanya untuk akun OAuth-only; jika terisi wajib berupa hash
  role                     UserRole  @default(USER) // lihat enum UserRole: tidak pernah dibaca dari JWT

  questionComments       QuestionComment[]
  deletedComments        QuestionComment[]           @relation("CommentDeletedBy")
  adminAuditLogs         AdminAuditLog[]             @relation("AdminAuditActor")
  attempts               Attempt[]
  kanaProgresses         KanaProgress[]
  flashcardCollection    FlashcardCollection?
  flashcardSubscriptions FlashcardDeckSubscription[]
  flashcardCards         FlashcardCard[]
  flashcardRevlogs       FlashcardRevlog[]
  practiceSessions       PracticeSession[]
  articleInteractions    ArticleInteraction[]
  authTokens             AuthToken[]
  oauthAccounts          OAuthAccount[]
  conversationSessions   ConversationSession[]
  conversationQuotas     ConversationQuota[]
  reports                Report[]                    @relation("ReportReporter")
  handledReports         Report[]                    @relation("ReportHandledBy")
  reportReplies          Report[]                    @relation("ReportRepliedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Partial index: baris ADMIN hanya segelintir, dan daftar admin dibaca jauh
  // lebih sering daripada diubah.
  @@index([role])
}

// Provider subject adalah identitas stabil. Email hanya snapshot untuk status
// account linking dan tidak pernah dipakai menggantikan providerAccountId.
model OAuthAccount {
  id                String        @id @default(uuid())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            Int
  provider          OAuthProvider
  providerAccountId String        @db.VarChar(255)
  providerEmail     String        @db.VarChar(254)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

// Token plaintext hanya dikirim melalui email. Database menyimpan SHA-256 hash
// dan maksimal satu token aktif untuk setiap user serta tujuan.
model AuthToken {
  id          String           @id @default(uuid())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  purpose     AuthTokenPurpose
  tokenHash   String           @unique
  targetEmail String?
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, purpose])
  @@index([expiresAt])
}

// ============================================================
// KANA & VOCABULARY STUDY
// ============================================================

// Kana content remains a reviewed static fixture. This table stores only
// per-user learning activity, keyed by the fixture's stable kana key.
model KanaProgress {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  kanaKey      String
  viewCount    Int       @default(0)
  correctCount Int       @default(0)
  againCount   Int       @default(0)
  lastViewedAt DateTime?
  lastGradedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kanaKey])
  @@index([userId, updatedAt])
}

// Pengaturan flashcard per user yang berlaku untuk semua deck, dibuat malas saat
// pertama dibutuhkan. Batas hari memakai `User.timeZone` (satu-satunya sumber
// zona waktu user) dengan jam rollover Anki: hari baru dimulai 04:00 lokal,
// bukan tengah malam. Penjadwalan diatur per deck di
// `FlashcardDeckSubscription.config`.
//
// `display` (tampilan kartu) divalidasi zod di src/features/flashcard/schemas.ts
// dan tidak pernah dibaca tanpa parse; field baru cukup diberi default di skema
// zod, tanpa migration.
model FlashcardCollection {
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @id

  rolloverHour Int  @default(4)
  display      Json @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Katalog kosakata bawaan, satu baris per kata. Diisi `npm run seed:flashcard`
// dari src/flashcard-data/vocab/*.json — file itu sumber kebenarannya.
//
// `key` adalah identitas stabil dari daftar kata sumber ("食事|しょくじ") yang
// dirujuk progres user lewat FlashcardCard. Kata yang hilang dari fixture tidak
// pernah dihapus, hanya diberi `retiredAt`; FK kartu memakai Restrict supaya
// penghapusan yang tidak disengaja gagal alih-alih ikut menghapus progres.
model FlashcardVocab {
  id    Int       @id @default(autoincrement())
  key   String    @unique @db.VarChar(160)
  level JlptLevel
  order Int

  word       String   @db.VarChar(200) // markup furigana {漢字|かな}
  wordPlain  String   @db.VarChar(200) // tanpa furigana, untuk sisi depan kartu
  reading    String   @db.VarChar(200)
  meaningsId String[]
  meaningsEn String[]
  examples   Json     @db.JsonB // [{ jp, id, en }], jp bermarkup
  notes      String   @default("") @db.Text
  tags       String[] // slug taxonomy, termasuk tag level

  // Jejak audit generator AI (lihat prisma/flashcard-vocab-prompt.mjs).
  aiModel       String   @db.VarChar(120)
  promptVersion String   @db.VarChar(60)
  generatedAt   DateTime

  retiredAt DateTime?

  cards    FlashcardCard[]
  reports  Report[]
  comments QuestionComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, order])
  @@index([tags], type: Gin)
}

// Katalog grammar bawaan. Fixture src/bunpou-data/ adalah sumber kebenaran;
// entri yang hilang atau belum lolos review dipensiunkan, bukan dihapus.
model BunpouPoint {
  id    Int        @id @default(autoincrement())
  key   String     @unique @db.VarChar(80)
  level JlptLevel
  order Int
  kind  BunpouKind

  sectionKey String  @db.VarChar(80)
  family     String? @db.VarChar(80)

  title        String @db.VarChar(240) // markup furigana
  titlePlain   String @db.VarChar(160)
  titleReading String @db.VarChar(240)
  titleRomaji  String @db.VarChar(240)
  meaningId    String @db.VarChar(240)
  meaningEn    String @db.VarChar(240)
  searchText   String @db.Text

  content Json     @db.JsonB
  tags    String[]

  // Provenance slide dan audit dua tahap generator.
  source        Json     @db.JsonB
  extract       Json     @db.JsonB
  review        Json?    @db.JsonB
  aiModel       String   @db.VarChar(120)
  promptVersion String   @db.VarChar(60)
  generatedAt   DateTime

  retiredAt DateTime?

  comparisons BunpouComparisonPoint[]
  reports     Report[]
  comments    QuestionComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([level, order])
  @@index([level, sectionKey, order])
  @@index([family])
  @@index([tags], type: Gin)
}

model BunpouComparison {
  id      Int    @id @default(autoincrement())
  key     String @unique @db.VarChar(80)
  title   String @db.VarChar(200)
  content Json   @db.JsonB

  aiModel       String    @db.VarChar(120)
  promptVersion String    @db.VarChar(60)
  generatedAt   DateTime
  reviewedAt    DateTime
  retiredAt     DateTime?

  points  BunpouComparisonPoint[]
  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BunpouComparisonPoint {
  comparisonId Int
  pointId      Int
  order        Int

  comparison BunpouComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  point      BunpouPoint      @relation(fields: [pointId], references: [id], onDelete: Restrict)

  @@id([comparisonId, pointId])
  @@unique([comparisonId, order])
  @@index([pointId])
}

// Deck bawaan = satu tag taxonomy. Isinya tidak disimpan: kata masuk deck bila
// `tags` memuat `slug` deck, sehingga satu kata bisa berada di beberapa deck
// (食事 di "JLPT N5" dan "Makanan & minuman") tanpa kartu ganda.
model FlashcardDeck {
  id          Int               @id @default(autoincrement())
  slug        String            @unique @db.VarChar(60)
  kind        FlashcardDeckKind
  name        String            @db.VarChar(120)
  nameJa      String            @default("") @db.VarChar(120)
  description String            @default("") @db.Text
  order       Int               @default(0)
  isPublished Boolean           @default(true)

  subscriptions FlashcardDeckSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, order])
}

// Deck yang ditambahkan user ke daftar belajarnya, sekaligus pemilik kartu dan
// pengaturan penjadwalannya (seperti deck options Anki, satu per deck).
//
// Melepas deck hanya mengisi `unsubscribedAt`: baris, kartu, dan pengaturannya
// tetap ada, dan kembali utuh saat deck ditambahkan lagi. Baris ini tidak
// pernah dihapus selama user ada — kartu ikut terhapus lewat cascade.
//
// `config` divalidasi zod (`FlashcardConfigSchema`) dan tidak pernah dibaca
// tanpa parse.
model FlashcardDeckSubscription {
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  deck   FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId Int

  config         Json      @db.JsonB
  unsubscribedAt DateTime?

  cards FlashcardCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, deckId])
  @@index([deckId])
}

// Progres satu user pada satu kata DI SATU DECK. Kata yang ada di dua deck
// (mis. JLPT N5 dan Makanan) adalah dua kartu dengan jadwal masing-masing,
// dijadwalkan dengan pengaturan deck pemiliknya. Baris dibuat saat kata pertama
// kali disentuh di deck itu (dijawab, ditunda, atau di-suspend); kata tanpa
// baris adalah kartu baru.
//
// `due` timestamp absolut, bukan integer relatif seperti Anki, sehingga satu
// query melayani semua queue. Kartu tertunda muncul lagi begitu `buriedUntil`
// terlewati — tanpa job unbury.
model FlashcardCard {
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  subscription FlashcardDeckSubscription @relation(fields: [userId, deckId], references: [userId, deckId], onDelete: Cascade)
  deckId       Int

  vocab   FlashcardVocab @relation(fields: [vocabId], references: [id], onDelete: Restrict)
  vocabId Int

  type  FlashcardCardType  @default(NEW)
  queue FlashcardCardQueue @default(NEW)
  due   DateTime

  intervalDays Int @default(0)
  reps         Int @default(0)
  lapses       Int @default(0)
  learningStep Int @default(0)

  // Memory state FSRS. Null selama kartu belum pernah dijadwalkan FSRS.
  stability        Float?
  difficulty       Float?
  desiredRetention Float?

  // Dipakai hanya saat FSRS dimatikan (fallback SM-2).
  easeFactor Float?

  lastReviewedAt DateTime?

  isSuspended Boolean   @default(false)
  buriedUntil DateTime?
  isLeech     Boolean   @default(false)

  revlogs FlashcardRevlog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, deckId, vocabId])
  @@index([userId, deckId, queue, due])
  @@index([vocabId])
}

// Riwayat review. Idempotency memakai `clientToken`, bukan primary key: submit
// ganda dari dua tab menjadi no-op tanpa membuka celah satu user memblokir
// review user lain. `previousState` adalah salinan kartu sebelum review ini
// (null bila kartu belum pernah ada), sehingga undo memulihkan keadaan persis.
model FlashcardRevlog {
  id BigInt @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  card    FlashcardCard @relation(fields: [userId, deckId, vocabId], references: [userId, deckId, vocabId], onDelete: Cascade)
  deckId  Int
  vocabId Int

  clientToken String? @db.VarChar(64)

  reviewedAt DateTime            @default(now())
  rating     FlashcardRating
  kind       FlashcardRevlogKind
  // Review pertama sebuah kartu baru; dasar hitungan batas kartu baru per hari
  // (per deck, lewat `deckId`).
  wasNew     Boolean             @default(false)

  intervalDays     Int
  lastIntervalDays Int
  stability        Float?
  difficulty       Float?
  easeFactor       Float?
  takenMs          Int    @default(0)

  previousState Json? @db.JsonB

  @@unique([userId, clientToken])
  @@index([userId, reviewedAt])
  @@index([userId, deckId, reviewedAt])
  @@index([userId, deckId, vocabId, reviewedAt])
}

// Jejak aksi admin. Role statis dua level berarti siapa pun yang dapat
// memperbaiki typo soal juga dapat menghapus akun user, jadi satu-satunya cara
// menelusuri apa yang terjadi adalah mencatatnya.
//
// Baris log tidak pernah diubah atau dihapus oleh aplikasi. Untuk aksi yang
// menulis ke database, log ditulis di transaksi yang sama supaya tidak pernah
// ada mutasi tanpa catatannya.
model AdminAuditLog {
  id Int @id @default(autoincrement())

  // SetNull, bukan Cascade: jejak aksi tidak boleh ikut hilang bersama akunnya.
  // Dalam alur normal ini tidak terpakai — penghapusan akun menganonimkan baris
  // User alih-alih menghapusnya. `actorName` adalah snapshot nama aktor, dan
  // anonimisasi menggantinya sambil mempertahankan barisnya: yang dibersihkan
  // identitasnya, bukan catatan akuntabilitasnya.
  actor     User?  @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   Int?
  actorName String @db.VarChar(120)

  // Format "domain.aksi", mis. "article.publish" atau "comment.takedown".
  action     String  @db.VarChar(64)
  targetType String  @db.VarChar(40)
  targetId   String? @db.VarChar(64)
  // Satu baris yang dapat dibaca manusia tanpa membuka data aslinya. Tidak
  // pernah memuat isi konten, kredensial, atau data pribadi.
  summary    String  @db.Text

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

// Bucket rate limit auth hanya menyimpan hash, bukan email atau alamat IP mentah.
model AuthRateLimit {
  keyHash         String    @id
  attemptCount    Int       @default(1)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

// ============================================================
// BANK SOAL (pure data soal, terpisah dari data attempt)
// ============================================================

// Satu paket ujian utuh, mis. "JLPT N2 - Juli 2025".
model TestPackage {
  id        Int       @id @default(autoincrement())
  name      String // "JLPT 2025 Juli", "JLPT 2024 Desember", dst.
  jlptLevel JlptLevel

  testPackageItems TestPackageItem[]
  questionContexts QuestionContext[]
  attempts         Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Satu blok mondai di dalam paket, mis. "問題1 漢字読み".
// Grouping: TestPackage -> TestPackageItem (per mondai) -> Question.
model TestPackageItem {
  id         Int         @id @default(autoincrement())
  mondaiType MondaiType
  section    JlptSection
  session    Int // sesi ujian ke berapa: 1 | 2 | 3
  order      Int // urutan mondai di dalam sesi (問題1, 問題2, ...)

  // Instruksi mondai, mis. 「＿＿の言葉の読み方として最もよいものを...」
  // Nullable karena bisa diisi belakangan / pakai template default per mondaiType.
  instruction String? @db.Text

  testPackageId Int
  testPackage   TestPackage @relation(fields: [testPackageId], references: [id], onDelete: Cascade)

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // satu paket tidak boleh punya 2 blok mondai bertipe sama
  @@unique([testPackageId, mondaiType])
}

// Konten bersama yang dipakai >1 soal:
// bacaan panjang dokkai, teks 文章の文法, atau audio choukai 統合理解.
// Soal yang kontennya hanya untuk dirinya sendiri TIDAK perlu context
// (pakai kolom di Question langsung).
model QuestionContext {
  id Int @id @default(autoincrement())

  // Context terikat ke paket: mencegah context "yatim" atau
  // tertukar dipakai soal dari paket lain.
  testPackageId Int
  testPackage   TestPackage @relation(fields: [testPackageId], references: [id], onDelete: Cascade)

  // Markup konten teks (berlaku juga untuk semua kolom teks soal):
  //   {漢字|かんじ}  -> furigana (render <ruby>)
  //   __teks__       -> underline (下線部)
  //   [_] dan [★]    -> slot kosong soal 文の組み立て
  storyText  String? @db.Text // bacaan/wacana; null jika context-nya hanya audio
  storyImage String? @db.Text // url gambar (brosur 情報検索, dsb.)
  storyAudio String? @db.Text // url audio yang dipakai beberapa soal

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testPackageId])
}

model Question {
  id Int @id @default(autoincrement())

  testPackageItem   TestPackageItem @relation(fields: [testPackageItemId], references: [id], onDelete: Cascade)
  testPackageItemId Int

  order Int // nomor soal di dalam mondai: 1,2,3,...

  // HANYA stem soal, mis. 「筆者の考えに合うものはどれか」.
  // Bacaan panjang yang dipakai beberapa soal masuk QuestionContext, BUKAN di sini.
  // Boleh string kosong untuk soal yang tidak punya stem tertulis
  // (mis. 即時応答 yang semuanya audio).
  questionText  String  @db.Text
  questionImage String? @db.Text // url gambar khusus soal ini (mis. 発話表現)
  questionAudio String? @db.Text // url audio khusus soal ini (mayoritas choukai = 1 audio per soal)

  questionChoices QuestionChoice[]

  // Kunci jawaban = codeAnswer pilihan yang benar (1-4).
  // Untuk 文の組み立て: pilihan yang jatuh di posisi ★ (sesuai format JLPT asli).
  questionAnswer Int

  // Pembahasan soal. Isinya terstruktur dan punya metadata audit sendiri,
  // jadi ditaruh di tabel terpisah (1:1) alih-alih satu kolom teks di sini.
  explanation QuestionExplanation?

  questionContext   QuestionContext? @relation(fields: [questionContextId], references: [id], onDelete: Cascade)
  questionContextId Int?

  questionComments QuestionComment[]
  attemptAnswers   AttemptAnswer[]
  practiceAnswers  PracticeAnswer[]
  reports          Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // mencegah nomor soal dobel saat ekstraksi AI
  @@unique([testPackageItemId, order])
  @@index([questionContextId])
}

model QuestionChoice {
  id         Int @id @default(autoincrement())
  codeAnswer Int // 1,2,3,4 -- direferensikan oleh Question.questionAnswer & AttemptAnswer.selectedAnswer

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int

  // Boleh string kosong untuk pilihan yang tidak tertulis
  // (mis. 即時応答: pilihan 1-3 hanya terdengar di audio).
  answerText  String  @db.Text
  answerImage String? @db.Text // url, untuk pilihan berupa gambar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // mencegah pilihan dengan kode sama dobel dalam satu soal
  @@unique([questionId, codeAnswer])
}

// Pembahasan resmi satu soal, dipakai di mode baca, hasil attempt, dan latihan
// cepat. Dipisah dari Question karena isinya diproduksi pipeline sendiri
// (`prisma/generate-question-explanation.mjs`) dan membawa metadata audit yang
// tidak ada hubungannya dengan soal: model apa yang menulis, versi prompt
// berapa, dan apakah sudah ditinjau manusia.
//
// Relasi ini WAJIB tidak pernah ikut terkirim saat mode ujian berjalan — sama
// seperti questionAnswer. Lihat aturan data-leak di docs/database.md.
model QuestionExplanation {
  id Int @id @default(autoincrement())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int      @unique

  // Markup teks Jepang yang berlaku sama dengan kolom soal lain. Hanya `summary`
  // yang wajib: pembahasan lama hasil ekstraksi dan catatan tulisan manusia
  // kerap hanya sebaris, tanpa analisis panjang maupun alasan per pilihan.
  summary     String   @db.Text // inti: kenapa kunci jawaban benar
  detail      String?  @db.Text // pembahasan menyeluruh: maksud soal, analisis kalimat
  translation String?  @db.Text // terjemahan kalimat kunci ke bahasa Indonesia
  keyPoints   String[] // kosakata/grammar yang diuji soal ini

  // Sinyal QA gratis dari generator: data soal berasal dari OCR, jadi kunci
  // jawaban bisa saja salah ketik. Model diminta menandainya alih-alih
  // memaksakan pembahasan untuk kunci yang tidak masuk akal.
  answerKeyDoubt     Boolean @default(false)
  answerKeyDoubtNote String? @db.Text

  // aiModel/promptVersion hanya terisi untuk source AI; baris HUMAN/IMPORTED
  // tidak punya keduanya.
  source        QuestionExplanationSource @default(AI)
  aiModel       String?                   @db.VarChar(64)
  promptVersion String?                   @db.VarChar(32)
  generatedAt   DateTime                  @default(now())
  reviewedAt    DateTime? // diisi saat pembahasan sudah dikurasi manusia

  choices QuestionExplanationChoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([answerKeyDoubt])
}

// Alasan per pilihan jawaban (4 baris per pembahasan, termasuk kunci yang benar
// supaya UI bisa merender sejajar dengan 4 opsi soal).
model QuestionExplanationChoice {
  id Int @id @default(autoincrement())

  explanation   QuestionExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)
  explanationId Int

  codeAnswer Int // 1-4, mengacu ke QuestionChoice.codeAnswer pada soal yang sama
  isCorrect  Boolean // denormalisasi dari Question.questionAnswer saat seed
  reason     String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([explanationId, codeAnswer])
}

// ============================================================
// CATATAN BELAJAR
// ============================================================

// Catatan/review per soal (beda dengan Question.explanation yang merupakan
// penjelasan "resmi"): insight, jebakan, mnemonic, dsb. Default privat; pemilik
// dapat membagikannya ke diskusi publik, dan balasan user lain menempel ke sana.
//
// Root vs reply: `parentId == null` berarti catatan/thread utama. Balasan hanya
// satu tingkat — balasan tidak boleh punya balasan lagi (dipaksa di action, yang
// mengarahkan reply-of-reply ke root yang sama).
//
// Tidak pernah hard delete: `deletedAt` membuat root tampil sebagai tombstone
// supaya balasan orang lain tidak ikut hilang. Isi teks/gambar comment yang
// deletedAt-nya terisi tidak boleh ikut dikirim ke client.
// Catatan belajar dan diskusi publik. Satu tabel melayani tiga target — soal
// (`questionId`), kata flashcard (`vocabId`), dan pola bunpou (`bunpouPointId`) —
// supaya aturan tombstone, balasan, mention, moderasi, laporan, dan anonimisasi
// akun berlaku sama untuk ketiganya. Tepat satu target terisi; CHECK-nya hanya ada di SQL migration
// (`QuestionComment_target_check`) karena Prisma tidak dapat mengekspresikannya.
model QuestionComment {
  id Int @id @default(autoincrement())

  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int?

  // Kata katalog, bukan kartu milik user: catatan untuk satu kata berlaku di
  // semua deck yang memuatnya. Restrict seperti `FlashcardCard.vocabId` — kata
  // tidak pernah dihapus (hanya `retiredAt`), dan penghapusan yang tidak
  // disengaja tidak boleh ikut memusnahkan percakapan.
  vocab   FlashcardVocab? @relation(fields: [vocabId], references: [id], onDelete: Restrict)
  vocabId Int?

  // Pola bunpou, per entri katalog (satu makna di satu level). Restrict dengan
  // alasan yang sama seperti `vocab`: katalog tidak pernah menghapus pola.
  bunpouPoint   BunpouPoint? @relation(fields: [bunpouPointId], references: [id], onDelete: Restrict)
  bunpouPointId Int?

  // Restrict, bukan Cascade: menghapus baris user akan ikut menghancurkan
  // balasan orang lain pada thread miliknya. Penghapusan akun menganonimkan
  // user dan men-soft-delete comment-nya — lihat `anonymizeAccount`.
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId Int

  // Balasan ikut terhapus bila root benar-benar dihapus dari database. Alur
  // aplikasi tidak pernah melakukannya; cascade ini hanya jaring pengaman untuk
  // penghapusan soal.
  parent   QuestionComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?
  replies  QuestionComment[] @relation("CommentReplies")

  // Balasan yang ditujukan ke comment tertentu di thread yang sama. Disimpan
  // sebagai relasi, bukan teks "@nama" di dalam commentText: nama yang diketik
  // akan basi begitu penulisnya ganti username, bisa dipalsukan, dan ambigu
  // karena displayName tidak unik. SetNull supaya comment tujuan yang dihapus
  // tidak ikut menghapus balasannya.
  repliedTo   QuestionComment?  @relation("CommentMentions", fields: [repliedToId], references: [id], onDelete: SetNull)
  repliedToId Int?
  mentionedBy QuestionComment[] @relation("CommentMentions")

  reports Report[]

  commentText   String   @db.Text
  commentImages String[] // url gambar lampiran

  visibility CommentVisibility @default(PRIVATE)
  // Terisi saat pertama kali dibagikan dan tidak pernah dikosongkan lagi. Jadi
  // penanda keanggotaan thread publik: root yang di-unshare tetap tampil sebagai
  // tombstone selama masih punya balasan.
  sharedAt   DateTime?
  deletedAt  DateTime?

  // Siapa yang menghapus. Tanpa kolom ini, takedown oleh admin tidak dapat
  // dibedakan dari pemilik yang menghapus catatannya sendiri — padahal hanya
  // takedown admin yang boleh dipulihkan; memulihkan hapusan pemilik berarti
  // menerbitkan ulang tulisan yang sengaja ia tarik.
  //
  // SetNull, bukan Cascade: akun admin yang dihapus tidak boleh ikut menghapus
  // baris komentar milik orang lain.
  deletedBy   User? @relation("CommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@index([userId])
  @@index([parentId])
  // Daftar catatan pribadi milik satu user pada satu soal.
  @@index([questionId, userId, deletedAt])
  // Daftar root thread publik pada satu soal.
  @@index([questionId, parentId, sharedAt])
  // Antrean moderasi: seluruh entri publik lintas soal, terbaru dulu.
  @@index([sharedAt])
  // Padanan tiga index di atas untuk catatan dan diskusi kata flashcard.
  @@index([vocabId])
  @@index([vocabId, userId, deletedAt])
  @@index([vocabId, parentId, sharedAt])
  // Padanan untuk catatan dan diskusi pola bunpou.
  @@index([bunpouPointId])
  @@index([bunpouPointId, userId, deletedAt])
  @@index([bunpouPointId, parentId, sharedAt])
  @@index([deletedById])
  @@index([repliedToId])
}

// ============================================================
// ATTEMPT & ANALITIK
// ============================================================

// Satu sesi pengerjaan. Analitik kelemahan per mondaiType:
// AttemptAnswer -> Question -> TestPackageItem, group by mondaiType.
model Attempt {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  testPackage   TestPackage @relation(fields: [testPackageId], references: [id], onDelete: Cascade)
  testPackageId Int

  // null = full test satu paket; diisi jika latihan satu seksi saja
  // (mis. hanya CHOUKAI). Soal yang dinilai difilter berdasarkan ini.
  sectionScope JlptSection?

  status     AttemptStatus @default(IN_PROGRESS)
  startedAt  DateTime      @default(now())
  finishedAt DateTime? // diisi saat submit; durasi total = finishedAt - startedAt

  answers AttemptAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([testPackageId])
}

model AttemptAnswer {
  id Int @id @default(autoincrement())

  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int

  selectedAnswer Int? // codeAnswer yang dipilih (1-4); null = tidak dijawab/dilewati

  // Denormalized dari (selectedAnswer == questionAnswer), dihitung saat submit.
  // Sengaja disimpan agar query analitik tidak perlu join kunci jawaban.
  isCorrect Boolean @default(false)

  flagged      Boolean @default(false) // ditandai ragu-ragu saat mengerjakan; flagged+salah = sinyal analitik bagus
  timeSpentSec Int? // waktu yang dihabiskan di soal ini (opsional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // satu soal hanya boleh punya satu jawaban per attempt (jawaban di-update, bukan insert baru)
  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ============================================================
// LATIHAN CEPAT
// ============================================================

// Latihan cepat memakai bank Question existing, tetapi session dan analitiknya
// terpisah dari Attempt agar tidak masuk ke proyeksi skor mock JLPT.
model PracticeSession {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  jlptLevel     JlptLevel
  section       JlptSection
  mondaiType    MondaiType
  questionCount Int

  status     PracticeSessionStatus @default(IN_PROGRESS)
  startedAt  DateTime              @default(now())
  finishedAt DateTime?

  answers PracticeAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([status])
  @@index([jlptLevel, section, mondaiType])
}

// Baris dibuat saat session dimulai. selectedAnswer/isCorrect/answeredAt masih
// null sampai user mengirim jawaban, sehingga urutan dan membership soal tetap
// dapat diverifikasi server-side sebelum feedback diberikan.
model PracticeAnswer {
  id Int @id @default(autoincrement())

  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  practiceSessionId Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int

  order          Int
  selectedAnswer Int?
  isCorrect      Boolean?
  answeredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([practiceSessionId, questionId])
  @@unique([practiceSessionId, order])
  @@index([questionId])
}

// ============================================================
// ARTIKEL PUBLIK
// ============================================================

// Body disimpan sebagai blok JSON terstruktur. Renderer memvalidasi setiap
// blok dengan Zod, sehingga konten tidak pernah dirender sebagai HTML mentah.
model Article {
  id Int @id @default(autoincrement())

  slug       String @unique
  title      String
  excerpt    String @db.Text
  body       Json   @db.JsonB
  bodyText   String @db.Text
  coverImage String @db.Text
  coverAlt   String

  authorName String
  authorRole String?

  category      String
  categorySlug  String
  status        ArticleStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  publishedAt   DateTime?
  readTime      Int
  viewCount     Int           @default(0)
  favoriteCount Int           @default(0)

  tagLinks     ArticleTagLink[]
  interactions ArticleInteraction[]
  reports      Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt, id])
  @@index([status, isFeatured, publishedAt])
  @@index([status, categorySlug, publishedAt])
}

model ArticleTag {
  id Int @id @default(autoincrement())

  slug  String @unique
  label String

  articleLinks ArticleTagLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArticleTagLink {
  id Int @id @default(autoincrement())

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  tag   ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId Int

  @@unique([articleId, tagId])
  @@index([tagId])
}

// Interaksi artikel hanya diakses lewat Prisma server-side karena aplikasi
// memakai custom numeric user ID, bukan UUID Supabase Auth.
model ArticleInteraction {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  saved        Boolean   @default(false)
  favorited    Boolean   @default(false)
  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId, saved, updatedAt])
  @@index([userId, favorited, updatedAt])
}

// ============================================================
// CONVERSATION & SPEAKING
// ============================================================

// Persona dan topik adalah fixture aplikasi, bukan konten database. Yang
// disimpan di sini hanya aktivitas milik user, dengan personaKey/topicKeys
// sebagai stable key yang harus cocok dengan fixture yang dikenal aplikasi.
model ConversationSession {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  mode       ConversationMode
  personaKey String           @db.VarChar(64)
  topicKeys  String[]
  jlptLevel  JlptLevel

  status     ConversationSessionStatus @default(ACTIVE)
  startedAt  DateTime                  @default(now())
  finishedAt DateTime?

  // Audit: hasil lama harus tetap dapat dijelaskan setelah prompt atau model
  // berubah.
  promptVersion String  @db.VarChar(32)
  chatModel     String  @db.VarChar(64)
  sttModel      String? @db.VarChar(64)
  ttsModel      String? @db.VarChar(64)

  // Snapshot consent saat session dibuat. Mencabut consent memicu penghapusan,
  // bukan penafsiran ulang data lama.
  transcriptRetained Boolean   @default(false)
  audioRetained      Boolean   @default(false)
  retentionExpiresAt DateTime?

  // Preferensi tampilan ikut disimpan supaya sesi dapat dilanjutkan di
  // perangkat lain persis seperti ditinggalkan.
  showTranslation Boolean @default(true)
  showRomaji      Boolean @default(true)
  showFurigana    Boolean @default(true)

  turnCount         Int @default(0)
  totalInputTokens  Int @default(0)
  totalOutputTokens Int @default(0)

  turns ConversationTurn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([status])
  @@index([retentionExpiresAt])
}

// Baris hanya dibuat bila session menyimpan transcript. Bila consent mati,
// agregat pada ConversationSession dan ConversationQuota tetap terisi sehingga
// pemakaian tetap terhitung tanpa menyimpan isi percakapan.
model ConversationTurn {
  id Int @id @default(autoincrement())

  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int

  order Int
  role  ConversationTurnRole

  contentJa          String  @db.Text
  contentTranslation String? @db.Text
  contentRomaji      String? @db.Text

  inputSource     ConversationInputSource?
  audioUrl        String?                  @db.Text
  audioPublicId   String?                  @unique @db.VarChar(255)
  audioDurationMs Int?
  sttConfidence   Float?

  moderationFlagged Boolean @default(false)
  latencyMs         Int?
  inputTokens       Int?
  outputTokens      Int?

  feedback ConversationTurnFeedback?

  createdAt DateTime @default(now())

  @@unique([sessionId, order])
  @@index([sessionId])
}

// Koreksi terstruktur untuk satu giliran user. Bentuknya blok JSON tervalidasi
// Zod, mengikuti pola Article.body — bukan HTML dan bukan teks bebas.
model ConversationTurnFeedback {
  id Int @id @default(autoincrement())

  turn   ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  turnId Int              @unique

  rubricVersion      String @db.VarChar(32)
  corrections        Json   @db.JsonB
  summary            String @db.Text
  pronunciationScore Float?

  createdAt DateTime @default(now())
}

// Counter harian per user. Diperbarui atomik seperti AuthRateLimit dan menjadi
// sumber kebenaran pemakaian serta audit biaya, walau transcript tidak disimpan.
// Penegakan batasnya menyusul dari modul plan/pricing; tahap sekarang hanya
// mencatat.
model ConversationQuota {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  quotaDate    DateTime @db.Date
  turnCount    Int      @default(0)
  audioSeconds Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, quotaDate])
  @@index([quotaDate])
}

// ============================================================
// LAPORAN PENGGUNA
// ============================================================

// Kotak masuk laporan: bug aplikasi, typo soal, kunci jawaban yang keliru,
// penyalahgunaan di diskusi, dan saran. Form-nya publik (guest boleh mengirim);
// daftarnya hanya terlihat di /admin.
//
// Target bersifat opsional dan memakai FK nyata, bukan pasangan
// (targetType, targetId) seperti `AdminAuditLog`. Perbedaannya bukan selera:
// baris audit HARUS bertahan setelah targetnya hilang, sedangkan laporan justru
// ada untuk membuka targetnya dan memperbaikinya. Sekali laporan tidak dapat
// di-join, layar admin berubah menjadi resolusi label per jenis target.
model Report {
  id Int @id @default(autoincrement())

  targetType ReportTargetType
  category   ReportCategory
  status     ReportStatus     @default(OPEN)

  // SetNull, bukan Cascade: menghapus satu soal tidak boleh ikut menghapus
  // laporan bug yang belum ditindak. `questionId` melayani DUA targetType —
  // QUESTION dan QUESTION_EXPLANATION — karena pembahasan di-upsert oleh
  // `seed:question-explanation` dan layar perbaikannya memang
  // /admin/explanation/[questionId].
  question   Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionId Int?

  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  articleId Int?

  comment   QuestionComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  commentId Int?

  // SetNull dengan alasan yang sama: laporan tidak boleh ikut terhapus bersama
  // targetnya, dan juga tidak boleh menahan penghapusannya. Katalog memang tidak
  // pernah menghapus kata (hanya `retiredAt`), dan penghapusan yang tidak
  // disengaja sudah ditahan `FlashcardCard.vocabId` (Restrict). Isi kartu tidak
  // diedit dari admin; perbaikannya lewat fixture lalu `seed:flashcard`.
  vocab   FlashcardVocab? @relation(fields: [vocabId], references: [id], onDelete: SetNull)
  vocabId Int?

  // Katalog bunpou, alasan SetNull sama dengan `vocab`: pola tidak pernah
  // dihapus (hanya `retiredAt`) dan perbaikannya lewat fixture lalu `seed:bunpou`.
  bunpouPoint        BunpouPoint?      @relation(fields: [bunpouPointId], references: [id], onDelete: SetNull)
  bunpouPointId      Int?
  bunpouComparison   BunpouComparison? @relation(fields: [bunpouComparisonId], references: [id], onDelete: SetNull)
  bunpouComparisonId Int?

  // Snapshot teks target saat laporan dibuat, mis. "N2 Juli 2025 · 文法 · soal 12".
  // Mengikuti pola `AdminAuditLog.actorName`: FK yang menjadi null karena
  // targetnya dihapus akan meninggalkan baris yang tidak terbaca tanpa ini.
  //
  // SELALU dibangun di server dari baris target. Label kiriman client dapat
  // dipalsukan dan menyuntikkan teks ke layar admin.
  targetLabel String? @db.VarChar(200)

  // Teks laporan apa adanya. Dirender sebagai plain text di admin — ini bukan
  // kolom markup Jepang dan tidak boleh diperlakukan sebagai markup.
  message String @db.Text

  // Null untuk guest. SetNull dan bukan Cascade karena laporan bug tetap perlu
  // ditindak setelah pelapornya menghapus akun; `anonymizeAccount` mengosongkan
  // identitasnya, bukan barisnya.
  reporter   User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId Int?

  // Konteks teknis untuk laporan bug. Tidak pernah memuat alamat IP mentah —
  // IP hanya dipakai sebagai subject bucket rate limit yang di-HMAC.
  pagePath  String? @db.VarChar(200)
  userAgent String? @db.VarChar(400)

  // Terisi hanya bila pelapor memang ingin dibalas. Data pribadi pada baris yang
  // bisa jadi tidak punya pemilik, jadi ada retensinya: cron membersihkan kolom
  // ini untuk laporan yang sudah selesai dan cukup tua.
  replyEmail String?

  // Balasan tidak pernah otomatis. Admin berhak menjawab atau tidak, dan hanya
  // satu balasan per laporan: `repliedAt` yang terisi mematikan tombolnya.
  repliedAt    DateTime?
  repliedBy    User?     @relation("ReportRepliedBy", fields: [repliedById], references: [id], onDelete: SetNull)
  repliedById  Int?
  replyMessage String?   @db.Text

  handledBy   User?     @relation("ReportHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  handledById Int?
  handledAt   DateTime?
  // Catatan internal. JANGAN pernah ikut dikirim ke pelapor.
  adminNote   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Antrean utama: status tertentu, terbaru dulu.
  @@index([status, createdAt])
  // Tab per jenis target.
  @@index([targetType, status])
  @@index([questionId])
  @@index([articleId])
  @@index([commentId])
  @@index([vocabId])
  @@index([bunpouPointId])
  @@index([bunpouComparisonId])
  @@index([reporterId])
  @@index([handledById])
  @@index([repliedById])
}
