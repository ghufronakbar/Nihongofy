generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // supabase: connection pooling via DATABASE_URL, migrasi via DIRECT_URL
}

// ============================================================
// ENUMS
// ============================================================

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum JlptSection {
  MOJI_GOI // 文字・語彙 (kosakata & kanji)
  BUNPOU // 文法 (tata bahasa)
  DOKKAI // 読解 (membaca)
  CHOUKAI // 聴解 (mendengarkan)
}

// Tipe mondai (問題). Menentukan format render di frontend,
// mis. BUNPOU_SENTENCE_COMPOSITION dirender dengan slot [_] dan [★].
enum MondaiType {
  // --- moji goi (文字・語彙) ---
  MOJI_GOI_READ_KANJI // 漢字読み: cara baca kanji yang digarisbawahi
  MOJI_GOI_WRITE_KANJI // 表記: kanji dari kata hiragana yang digarisbawahi
  MOJI_GOI_WORD_FORMATION // 語形成: pembentukan kata (imbuhan/kata majemuk)
  MOJI_GOI_CONTEXT // 文脈規定: kata yang tepat sesuai konteks kalimat
  MOJI_GOI_SYNONYM // 言い換え類義: sinonim/parafrase kata yang digarisbawahi
  MOJI_GOI_WORD_USAGE // 用法: penggunaan kata yang benar dalam kalimat

  // --- bunpou (文法) ---
  BUNPOU_GRAMMAR // 文法形式の判断: pilih bentuk grammar yang tepat
  BUNPOU_SENTENCE_COMPOSITION // 文の組み立て: susun kalimat, jawaban = posisi ★
  BUNPOU_TEXT_GRAMMAR // 文章の文法: grammar dalam wacana (cloze test)

  // --- dokkai (読解) ---
  DOKKAI_SHORT_TEXT // 内容理解（短文）
  DOKKAI_MEDIUM_TEXT // 内容理解（中文）
  DOKKAI_LONG_TEXT // 内容理解（長文）
  DOKKAI_INTEGRATED // 統合理解: membandingkan 2 teks
  DOKKAI_MAIN_IDEA // 主張理解: memahami klaim/opini penulis
  DOKKAI_INFORMATION_RETRIEVAL // 情報検索: cari info dari pengumuman/brosur

  // --- choukai (聴解) ---
  CHOUKAI_TASK_BASED // 課題理解: apa yang harus dilakukan selanjutnya
  CHOUKAI_MAIN_POINT // ポイント理解: poin penting dari percakapan
  CHOUKAI_OUTLINE // 概要理解: gambaran umum isi audio
  CHOUKAI_EXPRESSION // 発話表現: ungkapan yang tepat untuk situasi (ada gambar)
  CHOUKAI_QUICK_RESPONSE // 即時応答: respon cepat, pilihan hanya audio
  CHOUKAI_INTEGRATED // 統合理解: audio panjang, integrasi informasi
}

enum AttemptStatus {
  IN_PROGRESS // sedang dikerjakan (timer jalan)
  COMPLETED // disubmit, sudah dinilai
  ABANDONED // ditinggal / dibatalkan, tidak masuk analitik
}

// ---- Flashcard (paritas Anki) ----

// Note type didefinisikan aplikasi, bukan user. Jumlah kartu per note ditentukan
// oleh kind ini (lihat src/features/flashcard/note-types.ts) — dari sinilah
// konsep sibling (dan burying) di Anki berasal.
enum FlashcardNoteTypeKind {
  BASIC
  BASIC_REVERSED
  VOCAB_JP
  KANJI
  KANA
  CLOZE
}

enum FlashcardDeckSource {
  SYSTEM
  IMPORTED
  MANUAL
}

enum FlashcardCardType {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

// Nilai negatif di Anki (suspended/buried) dimodelkan sebagai varian eksplisit
// supaya query queue tidak perlu tahu konvensi angka Anki.
enum FlashcardCardQueue {
  NEW
  LEARNING
  REVIEW
  DAY_LEARN
  SUSPENDED
  BURIED_USER
  BURIED_SIBLING
}

enum FlashcardRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum FlashcardRevlogKind {
  LEARN
  REVIEW
  RELEARN
  MANUAL
  RESCHEDULED
}

enum FlashcardImportStatus {
  PENDING
  PARSING
  IMPORTING
  DONE
  FAILED
}

enum PracticeSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  EMAIL_CHANGE
  PASSWORD_RESET
}

enum OAuthProvider {
  GOOGLE
}

// ============================================================
// USER
// ============================================================

// Username tetap nullable sebagai bridge login akun legacy. User baru memakai
// displayName + normalized email; seluruh relasi existing tetap dipertahankan.
model User {
  id                       Int       @id @default(autoincrement())
  username                 String?   @unique // bridge login akun legacy; user baru memakai email
  displayName              String
  email                    String?   @unique // nullable hanya untuk akun legacy yang belum dibackfill
  emailVerifiedAt          DateTime?
  avatarUrl                String?   @db.Text
  avatarPublicId           String?   @unique @db.VarChar(255)
  avatarFormat             String?   @db.VarChar(10)
  avatarBytes              Int?
  timeZone                 String    @default("Asia/Jakarta") @db.VarChar(100)
  allowAudioStorage        Boolean   @default(false)
  allowConversationStorage Boolean   @default(false)
  deletionRequestedAt      DateTime?
  deletionScheduledFor     DateTime?
  password                 String? // null hanya untuk akun OAuth-only; jika terisi wajib berupa hash

  questionComments    QuestionComment[]
  attempts            Attempt[]
  kanaProgresses      KanaProgress[]
  flashcardCollection FlashcardCollection?
  flashcardDecks      FlashcardDeck[]
  flashcardPresets    FlashcardPreset[]
  flashcardNotes      FlashcardNote[]
  flashcardCards      FlashcardCard[]
  flashcardRevlogs    FlashcardRevlog[]
  flashcardImportJobs FlashcardImportJob[]
  practiceSessions    PracticeSession[]
  articleInteractions ArticleInteraction[]
  authTokens          AuthToken[]
  oauthAccounts       OAuthAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Provider subject adalah identitas stabil. Email hanya snapshot untuk status
// account linking dan tidak pernah dipakai menggantikan providerAccountId.
model OAuthAccount {
  id                String        @id @default(uuid())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            Int
  provider          OAuthProvider
  providerAccountId String        @db.VarChar(255)
  providerEmail     String        @db.VarChar(254)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

// Token plaintext hanya dikirim melalui email. Database menyimpan SHA-256 hash
// dan maksimal satu token aktif untuk setiap user serta tujuan.
model AuthToken {
  id          String           @id @default(uuid())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  purpose     AuthTokenPurpose
  tokenHash   String           @unique
  targetEmail String?
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, purpose])
  @@index([expiresAt])
}

// ============================================================
// KANA & VOCABULARY STUDY
// ============================================================

// Kana content remains a reviewed static fixture. This table stores only
// per-user learning activity, keyed by the fixture's stable kana key.
model KanaProgress {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  kanaKey      String
  viewCount    Int       @default(0)
  correctCount Int       @default(0)
  againCount   Int       @default(0)
  lastViewedAt DateTime?
  lastGradedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kanaKey])
  @@index([userId, updatedAt])
}

// Satu koleksi per user, meniru `col` di Anki. `createdAtDay` adalah anchor
// perhitungan hari dan `rolloverHour` menggantikan asumsi "hari mulai 00:00":
// di Anki hari baru dimulai jam 04:00 lokal, bukan tengah malam.
model FlashcardCollection {
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @id

  createdAtDay DateTime
  rolloverHour Int      @default(4)
  timeZone     String   @default("Asia/Jakarta") @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Deck options Anki adalah preset yang dipakai bersama banyak deck, bukan
// setting global per user. `config` disimpan sebagai JSONB dan divalidasi zod
// (src/features/flashcard/schemas.ts) karena tidak ada satu pun setting yang
// perlu di-query atau di-index, sementara daftarnya akan terus bertambah.
model FlashcardPreset {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  name   String @db.VarChar(120)
  config Json   @db.JsonB

  decks FlashcardDeck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// `name` hierarkis dengan pemisah "::" persis seperti Anki ("Core::N3::Verbs").
// Deck bawaan di-copy penuh ke koleksi user saat ditambahkan, jadi setelah
// import deck sepenuhnya milik user; `sourceRef` hanya jejak asal.
model FlashcardDeck {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  name        String  @db.VarChar(500)
  description String  @default("") @db.Text
  collapsed   Boolean @default(false)

  preset   FlashcardPreset @relation(fields: [presetId], references: [id])
  presetId Int

  sourceKind FlashcardDeckSource @default(MANUAL)
  sourceRef  String?             @db.VarChar(200)

  cards FlashcardCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([presetId])
}

// `fields` menggantikan string ber-separator 0x1F milik Anki; konversi hanya
// terjadi di boundary import/export. `guid` + `checksum` adalah kunci dedup:
// re-import deck yang sama memperbarui note tanpa mereset jadwal kartunya.
model FlashcardNote {
  id BigInt @id

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  noteType FlashcardNoteTypeKind
  guid     String                @db.VarChar(64)
  fields   String[]
  tags     String[]
  checksum Int

  cards FlashcardCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, guid])
  @@index([userId, noteType, checksum])
}

// Satu note menghasilkan beberapa card (ord = index template note type), dan
// card bersaudara inilah dasar fitur burying.
//
// `due` sengaja disimpan sebagai timestamp absolut, berbeda dari Anki yang
// memakai integer relatif `col.crt` dengan satuan berbeda per queue (posisi
// untuk new, epoch detik untuk learning, nomor hari untuk review). Timestamp
// membuat satu query melayani semua queue: `WHERE due <= now()`.
model FlashcardCard {
  id BigInt @id

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  note   FlashcardNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId BigInt

  deck   FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId Int

  ord Int

  type     FlashcardCardType  @default(NEW)
  queue    FlashcardCardQueue @default(NEW)
  due      DateTime
  position Int                @default(0)

  intervalDays Int @default(0)
  reps         Int @default(0)
  lapses       Int @default(0)
  learningStep Int @default(0)
  flags        Int @default(0)

  // Memory state FSRS. Null selama kartu belum pernah dijadwalkan FSRS.
  stability        Float?
  difficulty       Float?
  desiredRetention Float?

  // Dipakai hanya saat FSRS dimatikan di preset (fallback SM-2).
  easeFactor Float?

  lastReviewedAt DateTime?

  revlogs FlashcardRevlog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([noteId, ord])
  @@index([userId, deckId, queue, due])
  @@index([userId, queue, due])
  @@index([deckId])
}

// `id` adalah epoch ms review, mengikuti Anki. Idempotency TIDAK memakai `id`
// melainkan `clientToken`: kalau client yang menentukan primary key global, satu
// user bisa memblokir review user lain dengan mengklaim id lebih dulu.
// `@@unique([userId, clientToken])` membuat tabrakan hanya mungkin dalam satu
// akun, yang justru perilaku yang diinginkan — submit ganda dari dua tab menjadi
// no-op alih-alih menggandakan review dan menembus daily limit.
//
// `deckId` disimpan agar daily limit bisa dihitung per deck.
model FlashcardRevlog {
  id BigInt @id

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  card   FlashcardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId BigInt

  deckId Int

  clientToken String? @db.VarChar(64)

  reviewedAt DateTime            @default(now())
  rating     FlashcardRating
  kind       FlashcardRevlogKind

  intervalDays     Int
  lastIntervalDays Int
  stability        Float?
  difficulty       Float?
  easeFactor       Float?
  takenMs          Int    @default(0)

  @@unique([userId, clientToken])
  @@index([userId, reviewedAt])
  @@index([cardId, reviewedAt])
  @@index([userId, deckId, reviewedAt])
}

// Katalog deck bawaan. Ini konten milik aplikasi, bukan koleksi user — karena
// itu tidak punya `userId` dan tidak pernah dijadwalkan. Saat user menambahkan
// deck bawaan, isinya di-COPY penuh ke koleksinya sehingga setelah itu deck
// sepenuhnya miliknya: boleh di-rename, ganti preset, atau hapus kartu tanpa
// memengaruhi user lain maupun katalog.
model FlashcardSystemDeck {
  id Int @id @default(autoincrement())

  slug        String                @unique @db.VarChar(120)
  name        String                @db.VarChar(500)
  description String                @default("") @db.Text
  jlptLevel   JlptLevel?
  noteType    FlashcardNoteTypeKind
  /// Wajib diisi dan ditampilkan di UI: sumber CC BY-SA mengikat atribusi.
  license     String                @db.VarChar(300)
  order       Int                   @default(0)
  isPublished Boolean               @default(true)

  notes FlashcardSystemNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, order])
}

model FlashcardSystemNote {
  id Int @id @default(autoincrement())

  deck   FlashcardSystemDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId Int

  guid   String   @db.VarChar(64)
  fields String[]
  tags   String[]
  order  Int      @default(0)

  @@unique([deckId, guid])
  @@index([deckId, order])
}

// Import CSV/TXT dikirim per batch dari browser, jadi job ini yang memegang
// progres lintas request (tidak ada satu pun request yang memproses file utuh).
model FlashcardImportJob {
  id String @id @default(uuid())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  status    FlashcardImportStatus @default(PENDING)
  fileName  String                @db.VarChar(255)
  totalRows Int                   @default(0)
  doneRows  Int                   @default(0)
  stats     Json?                 @db.JsonB
  error     String?               @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// Bucket rate limit auth hanya menyimpan hash, bukan email atau alamat IP mentah.
model AuthRateLimit {
  keyHash         String    @id
  attemptCount    Int       @default(1)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

// ============================================================
// BANK SOAL (pure data soal, terpisah dari data attempt)
// ============================================================

// Satu paket ujian utuh, mis. "JLPT N2 - Juli 2025".
model TestPackage {
  id        Int       @id @default(autoincrement())
  name      String // "JLPT 2025 Juli", "JLPT 2024 Desember", dst.
  jlptLevel JlptLevel

  testPackageItems TestPackageItem[]
  questionContexts QuestionContext[]
  attempts         Attempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Satu blok mondai di dalam paket, mis. "問題1 漢字読み".
// Grouping: TestPackage -> TestPackageItem (per mondai) -> Question.
model TestPackageItem {
  id         Int         @id @default(autoincrement())
  mondaiType MondaiType
  section    JlptSection
  session    Int // sesi ujian ke berapa: 1 | 2 | 3
  order      Int // urutan mondai di dalam sesi (問題1, 問題2, ...)

  // Instruksi mondai, mis. 「＿＿の言葉の読み方として最もよいものを...」
  // Nullable karena bisa diisi belakangan / pakai template default per mondaiType.
  instruction String? @db.Text

  testPackageId Int
  testPackage   TestPackage @relation(fields: [testPackageId], references: [id], onDelete: Cascade)

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // satu paket tidak boleh punya 2 blok mondai bertipe sama
  @@unique([testPackageId, mondaiType])
}

// Konten bersama yang dipakai >1 soal:
// bacaan panjang dokkai, teks 文章の文法, atau audio choukai 統合理解.
// Soal yang kontennya hanya untuk dirinya sendiri TIDAK perlu context
// (pakai kolom di Question langsung).
model QuestionContext {
  id Int @id @default(autoincrement())

  // Context terikat ke paket: mencegah context "yatim" atau
  // tertukar dipakai soal dari paket lain.
  testPackageId Int
  testPackage   TestPackage @relation(fields: [testPackageId], references: [id], onDelete: Cascade)

  // Markup konten teks (berlaku juga untuk semua kolom teks soal):
  //   {漢字|かんじ}  -> furigana (render <ruby>)
  //   __teks__       -> underline (下線部)
  //   [_] dan [★]    -> slot kosong soal 文の組み立て
  storyText  String? @db.Text // bacaan/wacana; null jika context-nya hanya audio
  storyImage String? @db.Text // url gambar (brosur 情報検索, dsb.)
  storyAudio String? @db.Text // url audio yang dipakai beberapa soal

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testPackageId])
}

model Question {
  id Int @id @default(autoincrement())

  testPackageItem   TestPackageItem @relation(fields: [testPackageItemId], references: [id], onDelete: Cascade)
  testPackageItemId Int

  order Int // nomor soal di dalam mondai: 1,2,3,...

  // HANYA stem soal, mis. 「筆者の考えに合うものはどれか」.
  // Bacaan panjang yang dipakai beberapa soal masuk QuestionContext, BUKAN di sini.
  // Boleh string kosong untuk soal yang tidak punya stem tertulis
  // (mis. 即時応答 yang semuanya audio).
  questionText  String  @db.Text
  questionImage String? @db.Text // url gambar khusus soal ini (mis. 発話表現)
  questionAudio String? @db.Text // url audio khusus soal ini (mayoritas choukai = 1 audio per soal)

  questionChoices QuestionChoice[]

  // Kunci jawaban = codeAnswer pilihan yang benar (1-4).
  // Untuk 文の組み立て: pilihan yang jatuh di posisi ★ (sesuai format JLPT asli).
  questionAnswer Int

  // Penjelasan soal (hasil koreksi AI ditempel di sini). Markup sama berlaku.
  explanation String? @db.Text

  questionContext   QuestionContext? @relation(fields: [questionContextId], references: [id], onDelete: Cascade)
  questionContextId Int?

  questionComments QuestionComment[]
  attemptAnswers   AttemptAnswer[]
  practiceAnswers  PracticeAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // mencegah nomor soal dobel saat ekstraksi AI
  @@unique([testPackageItemId, order])
  @@index([questionContextId])
}

model QuestionChoice {
  id         Int @id @default(autoincrement())
  codeAnswer Int // 1,2,3,4 -- direferensikan oleh Question.questionAnswer & AttemptAnswer.selectedAnswer

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int

  // Boleh string kosong untuk pilihan yang tidak tertulis
  // (mis. 即時応答: pilihan 1-3 hanya terdengar di audio).
  answerText  String  @db.Text
  answerImage String? @db.Text // url, untuk pilihan berupa gambar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // mencegah pilihan dengan kode sama dobel dalam satu soal
  @@unique([questionId, codeAnswer])
}

// ============================================================
// CATATAN BELAJAR
// ============================================================

// Catatan/review pribadi per soal (beda dengan Question.explanation
// yang merupakan penjelasan "resmi"): insight, jebakan, mnemonic, dsb.
model QuestionComment {
  id Int @id @default(autoincrement())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  commentText   String   @db.Text
  commentImages String[] // url gambar lampiran

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@index([userId])
}

// ============================================================
// ATTEMPT & ANALITIK
// ============================================================

// Satu sesi pengerjaan. Analitik kelemahan per mondaiType:
// AttemptAnswer -> Question -> TestPackageItem, group by mondaiType.
model Attempt {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  testPackage   TestPackage @relation(fields: [testPackageId], references: [id], onDelete: Cascade)
  testPackageId Int

  // null = full test satu paket; diisi jika latihan satu seksi saja
  // (mis. hanya CHOUKAI). Soal yang dinilai difilter berdasarkan ini.
  sectionScope JlptSection?

  status     AttemptStatus @default(IN_PROGRESS)
  startedAt  DateTime      @default(now())
  finishedAt DateTime? // diisi saat submit; durasi total = finishedAt - startedAt

  answers AttemptAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([testPackageId])
}

model AttemptAnswer {
  id Int @id @default(autoincrement())

  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int

  selectedAnswer Int? // codeAnswer yang dipilih (1-4); null = tidak dijawab/dilewati

  // Denormalized dari (selectedAnswer == questionAnswer), dihitung saat submit.
  // Sengaja disimpan agar query analitik tidak perlu join kunci jawaban.
  isCorrect Boolean @default(false)

  flagged      Boolean @default(false) // ditandai ragu-ragu saat mengerjakan; flagged+salah = sinyal analitik bagus
  timeSpentSec Int? // waktu yang dihabiskan di soal ini (opsional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // satu soal hanya boleh punya satu jawaban per attempt (jawaban di-update, bukan insert baru)
  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ============================================================
// LATIHAN CEPAT
// ============================================================

// Latihan cepat memakai bank Question existing, tetapi session dan analitiknya
// terpisah dari Attempt agar tidak masuk ke proyeksi skor mock JLPT.
model PracticeSession {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  jlptLevel     JlptLevel
  section       JlptSection
  mondaiType    MondaiType
  questionCount Int

  status     PracticeSessionStatus @default(IN_PROGRESS)
  startedAt  DateTime              @default(now())
  finishedAt DateTime?

  answers PracticeAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([status])
  @@index([jlptLevel, section, mondaiType])
}

// Baris dibuat saat session dimulai. selectedAnswer/isCorrect/answeredAt masih
// null sampai user mengirim jawaban, sehingga urutan dan membership soal tetap
// dapat diverifikasi server-side sebelum feedback diberikan.
model PracticeAnswer {
  id Int @id @default(autoincrement())

  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  practiceSessionId Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int

  order          Int
  selectedAnswer Int?
  isCorrect      Boolean?
  answeredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([practiceSessionId, questionId])
  @@unique([practiceSessionId, order])
  @@index([questionId])
}

// ============================================================
// ARTIKEL PUBLIK
// ============================================================

// Body disimpan sebagai blok JSON terstruktur. Renderer memvalidasi setiap
// blok dengan Zod, sehingga konten tidak pernah dirender sebagai HTML mentah.
model Article {
  id Int @id @default(autoincrement())

  slug       String @unique
  title      String
  excerpt    String @db.Text
  body       Json   @db.JsonB
  bodyText   String @db.Text
  coverImage String @db.Text
  coverAlt   String

  authorName String
  authorRole String?

  category      String
  categorySlug  String
  status        ArticleStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  publishedAt   DateTime?
  readTime      Int
  viewCount     Int           @default(0)
  favoriteCount Int           @default(0)

  tagLinks     ArticleTagLink[]
  interactions ArticleInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt, id])
  @@index([status, isFeatured, publishedAt])
  @@index([status, categorySlug, publishedAt])
}

model ArticleTag {
  id Int @id @default(autoincrement())

  slug  String @unique
  label String

  articleLinks ArticleTagLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArticleTagLink {
  id Int @id @default(autoincrement())

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  tag   ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId Int

  @@unique([articleId, tagId])
  @@index([tagId])
}

// Interaksi artikel hanya diakses lewat Prisma server-side karena aplikasi
// memakai custom numeric user ID, bukan UUID Supabase Auth.
model ArticleInteraction {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  saved        Boolean   @default(false)
  favorited    Boolean   @default(false)
  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId, saved, updatedAt])
  @@index([userId, favorited, updatedAt])
}
