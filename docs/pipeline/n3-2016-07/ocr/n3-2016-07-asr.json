{
  "language": "ja",
  "duration": 1999.281625,
  "segments": [
    {
      "start": 0.56,
      "end": 6.06,
      "text": "想像 背考 日語 更 快速 高校 マン 搜索 微信 小程序 日語 輕鬆考"
    },
    {
      "start": 10.21,
      "end": 11.21,
      "text": "一番"
    },
    {
      "start": 11.71,
      "end": 16.21,
      "text": "市役所 で 男 の 人 と 女 の 人 が 話し て い ます"
    },
    {
      "start": 17.21,
      "end": 21.71,
      "text": "男 の 人 は この 後 何 を し なけれ ば なり ませ ん か"
    },
    {
      "start": 22.21,
      "end": 26.96,
      "text": "課長 来週 行う 経済 セミナー の 件 です が"
    },
    {
      "start": 27.46,
      "end": 31.46,
      "text": "さっき 見てみ たら 当日 使う 予定 の マイク が 一本 壊れて た ん です"
    },
    {
      "start": 31.46,
      "end": 36.46,
      "text": "そう 確か 市民 課 に 新しい の が ある はず だ から 借り て き ます"
    },
    {
      "start": 37.46,
      "end": 40.46,
      "text": "ちょうど 今 から 別 の よう で 行く ところ です から"
    },
    {
      "start": 40.96,
      "end": 41.96,
      "text": "ありがとうございます"
    },
    {
      "start": 42.46,
      "end": 46.46,
      "text": "あ 当日 配る 資料 だ けど 公園 し て いただく 森 先生 に"
    },
    {
      "start": 46.96,
      "end": 50.96,
      "text": "前 に お 送っ て もらっ た もの で いい か 確認 し て おい て くれ ます か"
    },
    {
      "start": 51.46,
      "end": 53.46,
      "text": "わかりました すぐ メール し ます"
    },
    {
      "start": 53.96,
      "end": 58.96,
      "text": "いえ メール は いつ 見て もらえる か わから ない から 電話 で お 願い し ます"
    },
    {
      "start": 59.46,
      "end": 60.46,
      "text": "あ はい"
    },
    {
      "start": 60.46,
      "end": 68.46,
      "text": "それ から スピーカー も 一応 音 が 出る か 確認 し て 駄目 だっ たら 市民 課 に 借り に 行っ て ください ね"
    },
    {
      "start": 68.96,
      "end": 71.46,
      "text": "それは さっき マイク の 確認 と 一緒 に し まし た"
    },
    {
      "start": 71.96,
      "end": 72.96,
      "text": "そう です か"
    },
    {
      "start": 78.7,
      "end": 83.2,
      "text": "男 の 人 は この 後 何 を しなけれ ば なり ませ ん か"
    },
    {
      "start": 83.7,
      "end": 99.74,
      "text": "2番"
    },
    {
      "start": 100.24,
      "end": 104.24,
      "text": "会社 で 男 の 人 と 女 の 人 が 話し て い ます"
    },
    {
      "start": 105.24,
      "end": 110.24,
      "text": "女 の 人 は この 後 まず 何 を しなけれ ば なり ませ ん か"
    },
    {
      "start": 112.59,
      "end": 113.59,
      "text": "鈴木 さん"
    },
    {
      "start": 113.59,
      "end": 119.09,
      "text": "来月 田中 部長 が 海外 の 視点 に 映られる こと に なっ た の 聞い た はい"
    },
    {
      "start": 119.59,
      "end": 122.09,
      "text": "部長 に は いろいろ 世話 に なっ た し"
    },
    {
      "start": 122.59,
      "end": 125.09,
      "text": "最後 に 食事会 を しよう と 思う ん だ けど"
    },
    {
      "start": 125.59,
      "end": 129.09,
      "text": "その 時 プレゼント と 一緒 に カード を 渡し たい ん だ"
    },
    {
      "start": 129.59,
      "end": 134.59,
      "text": "悪い ん だ けど カード 買っ て みんな に 回し て メッセージ を 書い て もらっ て"
    },
    {
      "start": 135.09,
      "end": 136.09,
      "text": "わかりました"
    },
    {
      "start": 136.59,
      "end": 139.09,
      "text": "人数 多く て 時間 かかる か も しれ ない から"
    },
    {
      "start": 139.59,
      "end": 141.59,
      "text": "明日 から で も 回し始め ない と ね"
    },
    {
      "start": 142.59,
      "end": 144.59,
      "text": "プレゼント は 私 が 何 か 用意 し て おく よ"
    },
    {
      "start": 145.09,
      "end": 145.59,
      "text": "はい"
    },
    {
      "start": 146.09,
      "end": 148.59,
      "text": "それ から 食事会 の 場所 だ ね"
    },
    {
      "start": 149.59,
      "end": 154.59,
      "text": "私 いい レストラン 知っ てる の で 日 が 決まっ たら 予約 し て おき ます"
    },
    {
      "start": 155.09,
      "end": 156.09,
      "text": "ありがとう"
    },
    {
      "start": 156.59,
      "end": 160.09,
      "text": "来週 部長 が 出張 から 戻られ たら ご予定 を 伺っ て みる よ"
    },
    {
      "start": 160.59,
      "end": 161.59,
      "text": "わかりました"
    },
    {
      "start": 167.3,
      "end": 171.8,
      "text": "女 の 人 は この 後 まず 何 を し なけれ ば なり ませ ん か"
    },
    {
      "start": 187.88,
      "end": 188.88,
      "text": "3番"
    },
    {
      "start": 189.38,
      "end": 193.38,
      "text": "日本語 学校 の 教室 で 先生 が 話し て い ます"
    },
    {
      "start": 194.38,
      "end": 198.88,
      "text": "学生 は この 後 まず 何 を し なけれ ば なり ませ ん か"
    },
    {
      "start": 200.62,
      "end": 204.62,
      "text": "今日は 中村 先生 が 急 な よう で いらっしゃら ない の で"
    },
    {
      "start": 205.12,
      "end": 206.62,
      "text": "代わり に 私 が 来 まし た"
    },
    {
      "start": 207.62,
      "end": 212.62,
      "text": "この 時間 は 一人 ずつ 自分 の 趣味 に つい て 発表 を する 予定 でし た が"
    },
    {
      "start": 213.62,
      "end": 215.62,
      "text": "それは 明日 の 授業 で し て もらい ます"
    },
    {
      "start": 216.62,
      "end": 219.62,
      "text": "いつ も やっ て いる 感じ テスト は 今日 あり ませ ん"
    },
    {
      "start": 220.62,
      "end": 224.62,
      "text": "えー 昨日 の 授業 で 物語 を 読み まし た ね"
    },
    {
      "start": 225.12,
      "end": 229.62,
      "text": "現行 用紙 を 配り ます から 乾燥 を 400 人 ぐらい で 書い て ください"
    },
    {
      "start": 230.62,
      "end": 233.62,
      "text": "それ から 昨日 宿題 が 出 まし た ね"
    },
    {
      "start": 234.62,
      "end": 236.12,
      "text": "教科書 の 練習 問題"
    },
    {
      "start": 236.62,
      "end": 239.62,
      "text": "それは 明日 中村 先生 に 出し て ください"
    },
    {
      "start": 240.62,
      "end": 241.62,
      "text": "じゃあ 始め ましょう"
    },
    {
      "start": 247.44,
      "end": 251.94,
      "text": "学生 は この 後 まず 何 を し なけれ ば なり ませ ん か"
    },
    {
      "start": 268.01,
      "end": 269.01,
      "text": "4番"
    },
    {
      "start": 269.51,
      "end": 273.51,
      "text": "スーパー で 店長 と 女 の 店員 が 話し て い ます"
    },
    {
      "start": 275.01,
      "end": 279.51,
      "text": "女 の 店員 は この 後 まず 何 を し なけれ ば なり ませ ん か"
    },
    {
      "start": 281.51,
      "end": 283.51,
      "text": "山田 さん おはよう ちょっと いい?"
    },
    {
      "start": 284.01,
      "end": 285.01,
      "text": "はい 店長"
    },
    {
      "start": 286.01,
      "end": 289.01,
      "text": "新しく バイト に 入っ た 駿くん の こと な ん だ けど"
    },
    {
      "start": 290.01,
      "end": 294.01,
      "text": "山田 さん が 指導 係 に なっ て いろいろ 教え たげ て ほしい ん だ"
    },
    {
      "start": 294.51,
      "end": 296.51,
      "text": "え? 私 が です か?"
    },
    {
      "start": 297.01,
      "end": 299.01,
      "text": "うん よろしく 頼む よ"
    },
    {
      "start": 300.01,
      "end": 303.51,
      "text": "今 林 君 に は 店 の 前 を 掃除 し て もらっ て る ん だ けど"
    },
    {
      "start": 304.01,
      "end": 305.01,
      "text": "もう 終わる 頃 だ から"
    },
    {
      "start": 305.51,
      "end": 309.01,
      "text": "店 の どこ に どんな 商品 が 並ん でる の か 教え て あげ て"
    },
    {
      "start": 309.51,
      "end": 310.01,
      "text": "はい"
    },
    {
      "start": 310.51,
      "end": 311.51,
      "text": "それ から"
    },
    {
      "start": 312.01,
      "end": 314.51,
      "text": "午後 は レジ の 仕事 の 説明 を お 願い"
    },
    {
      "start": 315.01,
      "end": 318.01,
      "text": "彼 に は できる だけ 早く レジ を 覚え て もらい たい ん だ"
    },
    {
      "start": 318.51,
      "end": 319.51,
      "text": "わかりました"
    },
    {
      "start": 320.51,
      "end": 325.01,
      "text": "閉店後 の 店 の 中 の 確認 も 一緒 に し た ほう が いい です か?"
    },
    {
      "start": 326.01,
      "end": 328.51,
      "text": "お客 さん の 落とし物 の 回収 と か"
    },
    {
      "start": 329.01,
      "end": 330.01,
      "text": "そうだ ね"
    },
    {
      "start": 330.51,
      "end": 332.01,
      "text": "それ も お 願い する よ"
    },
    {
      "start": 337.85,
      "end": 342.85,
      "text": "女 の 店員 は この 後 まず 何 を し なけれ ば なり ませ ん か"
    },
    {
      "start": 358.46,
      "end": 359.46,
      "text": "午晩"
    },
    {
      "start": 359.96,
      "end": 361.46,
      "text": "ゴルフ 教室 で"
    },
    {
      "start": 361.96,
      "end": 364.96,
      "text": "男 の 人 と 受け付け の 人 が 話し て い ます"
    },
    {
      "start": 365.96,
      "end": 370.46,
      "text": "男 の 人 は この 後 どの クラス に 申し込み ます か"
    },
    {
      "start": 372.46,
      "end": 373.96,
      "text": "あの すみません"
    },
    {
      "start": 374.46,
      "end": 377.46,
      "text": "ゴルフ の レッスン に 申し込み たい ん です が"
    },
    {
      "start": 377.96,
      "end": 380.96,
      "text": "どの クラス に すれ ば いい の か よく わから なく て"
    },
    {
      "start": 381.46,
      "end": 381.96,
      "text": "はい"
    },
    {
      "start": 382.46,
      "end": 384.96,
      "text": "クラス は 全部 で 4 つ あり ます が"
    },
    {
      "start": 385.46,
      "end": 387.46,
      "text": "ゴルフ は 初めて です か?"
    },
    {
      "start": 387.96,
      "end": 388.46,
      "text": "いえ"
    },
    {
      "start": 388.96,
      "end": 389.96,
      "text": "以前 やっ て まし た"
    },
    {
      "start": 390.46,
      "end": 391.46,
      "text": "そう です か"
    },
    {
      "start": 391.96,
      "end": 395.46,
      "text": "では 入門 は 初めて の 方 の クラス な の で"
    },
    {
      "start": 395.96,
      "end": 399.46,
      "text": "経験 者 の 方 は それ 以外 の 初級"
    },
    {
      "start": 399.96,
      "end": 403.96,
      "text": "中級 上級 の 3 つ の 中 から お 選び ください"
    },
    {
      "start": 404.96,
      "end": 407.46,
      "text": "それぞれ どんな こと を する ん でしょう か"
    },
    {
      "start": 407.96,
      "end": 414.46,
      "text": "初級 は 入門 クラス で 習っ た 基本 的 な 打ち方 を しっかり 身に つける クラス です"
    },
    {
      "start": 415.96,
      "end": 420.96,
      "text": "中級 は 基礎 身に つけ た 人 が いろいろ な 技術 を 学ぶ クラス です"
    },
    {
      "start": 421.46,
      "end": 421.96,
      "text": "はい"
    },
    {
      "start": 422.46,
      "end": 427.46,
      "text": "上級 は 死の大会 を 目標 に 頑張っ て いる 方 が 多い です よ"
    },
    {
      "start": 428.46,
      "end": 429.46,
      "text": "死の大会 です か"
    },
    {
      "start": 430.46,
      "end": 434.46,
      "text": "昔 は よく 出 て た ん です けど しばらく やっ て ない し"
    },
    {
      "start": 434.96,
      "end": 440.96,
      "text": "あ すみません この クラス 今 定員 が いっぱい に なっ て まし た"
    },
    {
      "start": 441.96,
      "end": 445.46,
      "text": "一 つ 下 の クラス から 始め て み て は いかが です か?"
    },
    {
      "start": 445.96,
      "end": 447.96,
      "text": "そうですね そう し ます"
    },
    {
      "start": 448.46,
      "end": 458.7,
      "text": "男 の 人 は この 後 どの クラス に 申し込み ます か?"
    },
    {
      "start": 459.2,
      "end": 475.24,
      "text": "6番"
    },
    {
      "start": 476.24,
      "end": 479.74,
      "text": "お 城 の 前 で 案内 の 人 が 話し て い ます"
    },
    {
      "start": 480.74,
      "end": 483.74,
      "text": "これ から お 城 の 中 を 見学 する 人 は"
    },
    {
      "start": 484.74,
      "end": 488.74,
      "text": "入り口 で 靴 を 抜い だ と 靴 を どう し ます か?"
    },
    {
      "start": 494.46,
      "end": 498.96,
      "text": "皆 さま これ から お 城 の 中 を 見学 し て いただき ます が"
    },
    {
      "start": 499.46,
      "end": 504.96,
      "text": "靴 は 入り口 で 抜い で 土 が 落ち ない ように 袋 に 入れ て おもち ください"
    },
    {
      "start": 505.96,
      "end": 507.96,
      "text": "袋 は 入り口 で お 渡し し ます"
    },
    {
      "start": 508.46,
      "end": 511.46,
      "text": "本 日 は 大変 混雑 し て いる ため"
    },
    {
      "start": 511.96,
      "end": 514.46,
      "text": "見学 通路 は 一方通行 に なっ て おり ます"
    },
    {
      "start": 515.46,
      "end": 517.46,
      "text": "入り口 と 出口 が 違い ます の で"
    },
    {
      "start": 517.96,
      "end": 520.46,
      "text": "入り口 に 靴 を 置く 棚 が ござい ます が"
    },
    {
      "start": 520.96,
      "end": 524.46,
      "text": "これは 本 日 は お 使い に なら ない ように し て ください"
    },
    {
      "start": 525.46,
      "end": 530.46,
      "text": "また 抜い だ 靴 を 入り口 の 隅 に 置い て いかない ように お 願い し ます"
    },
    {
      "start": 538.26,
      "end": 541.26,
      "text": "これ から お 城 の 中 を 見学 する 人 は"
    },
    {
      "start": 541.26,
      "end": 545.76,
      "text": "入り口 で 靴 を 抜い だ と 靴 を どう し ます か"
    },
    {
      "start": 546.26,
      "end": 562.42,
      "text": "一番"
    },
    {
      "start": 562.92,
      "end": 567.42,
      "text": "携帯 電話 で 女 の 人 と 男 の 人 が 話し て い ます"
    },
    {
      "start": 568.42,
      "end": 570.92,
      "text": "二人 は どこ で 会い ます か"
    },
    {
      "start": 571.42,
      "end": 598.28,
      "text": "もし もし 佐藤 君 今 どこ"
    },
    {
      "start": 598.78,
      "end": 601.78,
      "text": "あ もう 駅 の 北口 の 改札 に つい てる よ"
    },
    {
      "start": 602.28,
      "end": 604.78,
      "text": "北口 の 改札 で 会う 約束 だ よ ね"
    },
    {
      "start": 605.28,
      "end": 609.28,
      "text": "ごめん 私 今 南口 に いる ん だ"
    },
    {
      "start": 610.28,
      "end": 613.28,
      "text": "さっき ハイ ヒール の カカト が 折れ ちゃっ て"
    },
    {
      "start": 613.78,
      "end": 618.78,
      "text": "確か 南口 の デパート に 靴 を 直せる ところ が あっ た から"
    },
    {
      "start": 619.28,
      "end": 621.28,
      "text": "ちょっと 寄っ て いき たい ん だ けど"
    },
    {
      "start": 621.78,
      "end": 622.28,
      "text": "そう"
    },
    {
      "start": 622.78,
      "end": 625.28,
      "text": "じゃあ 僕 も 南口 の デパート に 行こう か"
    },
    {
      "start": 625.78,
      "end": 626.78,
      "text": "うん"
    },
    {
      "start": 627.28,
      "end": 630.28,
      "text": "北口 に よく 行く カフェ が ある よ ね"
    },
    {
      "start": 630.78,
      "end": 632.78,
      "text": "時間 かかる か も しれ ない から"
    },
    {
      "start": 633.28,
      "end": 634.78,
      "text": "そこ で 待って て"
    },
    {
      "start": 635.28,
      "end": 636.78,
      "text": "わかった じゃあ 後 で"
    },
    {
      "start": 637.28,
      "end": 644.66,
      "text": "二人 は どこ で 会い ます か"
    },
    {
      "start": 660.67,
      "end": 661.67,
      "text": "二番"
    },
    {
      "start": 662.17,
      "end": 666.17,
      "text": "会社 で 女 の 人 と 男 の 人 が 話し て い ます"
    },
    {
      "start": 667.17,
      "end": 671.67,
      "text": "男 の 人 は どう し て 今 の 家 に 住ん で い ます か"
    },
    {
      "start": 695.4,
      "end": 699.4,
      "text": "きむら さん て 通勤 に 2 時間 かかる ん だっ て"
    },
    {
      "start": 699.9,
      "end": 702.4,
      "text": "ご 両親 の 家 から 通っ て いる の"
    },
    {
      "start": 702.9,
      "end": 704.4,
      "text": "あ 独り 暮らし だ よ"
    },
    {
      "start": 704.9,
      "end": 705.9,
      "text": "うーん"
    },
    {
      "start": 706.4,
      "end": 709.9,
      "text": "独り 暮らし なら 会社 の 近く に も 住める の に"
    },
    {
      "start": 710.4,
      "end": 711.9,
      "text": "どう し て 遠く に"
    },
    {
      "start": 712.4,
      "end": 715.4,
      "text": "会社 の 近く より 家賃 が 安い の"
    },
    {
      "start": 715.9,
      "end": 718.4,
      "text": "いや 家賃 は そんな に 変わら ない けど"
    },
    {
      "start": 718.9,
      "end": 721.4,
      "text": "部屋 が たくさん あっ て 庭 も ある ん だ"
    },
    {
      "start": 721.9,
      "end": 724.4,
      "text": "僕 本 を たくさん 持っ てる から"
    },
    {
      "start": 724.9,
      "end": 726.4,
      "text": "置い て おける 部屋 が ある と 便利 で"
    },
    {
      "start": 726.9,
      "end": 728.4,
      "text": "そう な ん だ"
    },
    {
      "start": 728.9,
      "end": 731.4,
      "text": "庭 が ある ん だら 犬 と か 買える よ ね"
    },
    {
      "start": 731.9,
      "end": 732.9,
      "text": "そうだ ね"
    },
    {
      "start": 733.4,
      "end": 735.4,
      "text": "でも 出張 なんか も ある し"
    },
    {
      "start": 735.9,
      "end": 738.4,
      "text": "ペット を 買う こと は 考え て ない ん だ"
    },
    {
      "start": 744.15,
      "end": 748.15,
      "text": "男 の 人 は どう し て 今 の 家 に 住ん で い ます か"
    },
    {
      "start": 748.65,
      "end": 764.75,
      "text": "3 番"
    },
    {
      "start": 765.25,
      "end": 770.25,
      "text": "テニス 教室 で 男 の 人 と 女 の 人 が 話し て い ます"
    },
    {
      "start": 771.25,
      "end": 776.75,
      "text": "女 の 人 は どう し て 最近 テニス が 上手く なっ た と 言っ て い ます か"
    },
    {
      "start": 800.61,
      "end": 803.61,
      "text": "ヤマダ さん 最近 テニス 上手く なっ た ね"
    },
    {
      "start": 804.11,
      "end": 805.61,
      "text": "あ は あり が と"
    },
    {
      "start": 806.11,
      "end": 809.61,
      "text": "ラケット と か 靴 と か 新しく し た から"
    },
    {
      "start": 810.11,
      "end": 813.11,
      "text": "え 道具 を 変える と うまく なる の"
    },
    {
      "start": 813.61,
      "end": 816.11,
      "text": "ごめん それ は 冗談"
    },
    {
      "start": 817.11,
      "end": 822.61,
      "text": "うまく なり たく て 何 か いい 方法 が ない か あれ これ やっ て み た の"
    },
    {
      "start": 823.61,
      "end": 826.61,
      "text": "教室 に き て 練習 する 日 を 増やし て み たり"
    },
    {
      "start": 827.11,
      "end": 829.11,
      "text": "先生 を 変え て み たり"
    },
    {
      "start": 829.61,
      "end": 830.61,
      "text": "それ から"
    },
    {
      "start": 831.11,
      "end": 833.61,
      "text": "自宅 で できる トレーニング を 始め て み たり"
    },
    {
      "start": 834.11,
      "end": 835.11,
      "text": "うん それ で"
    },
    {
      "start": 835.61,
      "end": 838.11,
      "text": "それで 私 の 場合 は"
    },
    {
      "start": 838.61,
      "end": 841.11,
      "text": "教室 に 来る 回数 を 増やす より"
    },
    {
      "start": 841.61,
      "end": 844.61,
      "text": "うち で 一人 で できる こと を やる 方 が"
    },
    {
      "start": 845.11,
      "end": 846.61,
      "text": "効果 的 だっ て わかっ た ん だ"
    },
    {
      "start": 847.11,
      "end": 849.11,
      "text": "そっ か なるほど"
    },
    {
      "start": 854.96,
      "end": 860.46,
      "text": "女 の 人 は どう し て 最近 テニス が うまく なっ た と 言っ て い ます か"
    },
    {
      "start": 875.93,
      "end": 876.93,
      "text": "4番"
    },
    {
      "start": 877.43,
      "end": 881.43,
      "text": "会社 で 女 の 人 と 男 の 人 が 話し て い ます"
    },
    {
      "start": 882.93,
      "end": 886.93,
      "text": "男 の 人 は どう し て お弁当 を 持っ て き て い ます か"
    },
    {
      "start": 886.93,
      "end": 913.69,
      "text": "加藤 さん 今日 も お弁当"
    },
    {
      "start": 914.19,
      "end": 916.19,
      "text": "毎朝 自分 で 作っ てる の"
    },
    {
      "start": 916.69,
      "end": 917.19,
      "text": "うん"
    },
    {
      "start": 917.69,
      "end": 922.19,
      "text": "何 を 作る か 毎日 考え なきゃ いけ ない の は ちょっと 大変 だ けど"
    },
    {
      "start": 922.69,
      "end": 924.69,
      "text": "料理 作る の 好き な の"
    },
    {
      "start": 925.19,
      "end": 927.69,
      "text": "いや あまり 好き じゃ ない ん だ けど"
    },
    {
      "start": 928.19,
      "end": 931.19,
      "text": "実 は 車 が 欲しく て ずっと 貯金 し て て"
    },
    {
      "start": 932.69,
      "end": 935.19,
      "text": "外食 する と 結構 お 金 が かかる よ ね"
    },
    {
      "start": 935.69,
      "end": 936.69,
      "text": "そうだ ね"
    },
    {
      "start": 937.69,
      "end": 943.19,
      "text": "お弁当 だ と 野菜 も たくさん 入れ られる から 健康 に も よさ そう だ ね"
    },
    {
      "start": 943.69,
      "end": 948.69,
      "text": "ああ 健康 の こと は あんまり 考え て なかっ た けど そう だ ね"
    },
    {
      "start": 949.19,
      "end": 958.4,
      "text": "男 の 人 は どう し て お弁当 を 持っ て き て い ます か"
    },
    {
      "start": 974.48,
      "end": 975.48,
      "text": "5番"
    },
    {
      "start": 975.98,
      "end": 978.98,
      "text": "男 の 人 と 女 の 人 が 話し て い ます"
    },
    {
      "start": 979.98,
      "end": 981.48,
      "text": "男 の 人 は"
    },
    {
      "start": 981.98,
      "end": 986.98,
      "text": "インターネット で 服 を 買わ ない 1 番 の 理由 は 何 だ と 言っ て い ます か"
    },
    {
      "start": 1011.18,
      "end": 1015.18,
      "text": "あ その 服 いい 色 だ ね どこ で 買っ た の"
    },
    {
      "start": 1015.68,
      "end": 1019.18,
      "text": "これ インターネット で 買っ た の いい でしょう"
    },
    {
      "start": 1019.68,
      "end": 1022.18,
      "text": "ああ インターネット ショッピング か"
    },
    {
      "start": 1022.68,
      "end": 1026.18,
      "text": "実 は 僕 インターネット で 服 を 買っ た こと ない ん だ"
    },
    {
      "start": 1027.18,
      "end": 1031.18,
      "text": "送料 が かかる し 品物 が 届く まで に 時間 が かかる ん でしょう"
    },
    {
      "start": 1031.68,
      "end": 1034.68,
      "text": "うん 送料 が かかる もの も ある よ"
    },
    {
      "start": 1035.18,
      "end": 1039.18,
      "text": "でも 家 に いて 簡単 に 買い物 が できる って"
    },
    {
      "start": 1039.68,
      "end": 1041.68,
      "text": "やっぱり 便利 だ と 思わ ない"
    },
    {
      "start": 1042.18,
      "end": 1043.68,
      "text": "うーん そう だ ね"
    },
    {
      "start": 1044.18,
      "end": 1049.18,
      "text": "ただ 大抵 注文 する 前 に 実物 を 着 て みる こと は でき ない ん だ よ ね"
    },
    {
      "start": 1049.68,
      "end": 1052.18,
      "text": "僕 は それ が 一番 気 に なる な"
    },
    {
      "start": 1052.68,
      "end": 1055.18,
      "text": "今 まで なんか 問題 なかっ た"
    },
    {
      "start": 1055.68,
      "end": 1056.18,
      "text": "うん"
    },
    {
      "start": 1056.68,
      "end": 1060.68,
      "text": "サイト を 見れ ば サイズ や 色 は わかる から 大丈夫 だ よ"
    },
    {
      "start": 1061.68,
      "end": 1063.68,
      "text": "私 は それ より"
    },
    {
      "start": 1064.18,
      "end": 1065.68,
      "text": "初めて 注文 し た とき"
    },
    {
      "start": 1066.18,
      "end": 1071.18,
      "text": "店 に 名前 と か 住所 と か 教え なきゃ なら ない こと が 気 に なっ た けど ね"
    },
    {
      "start": 1076.96,
      "end": 1078.46,
      "text": "男 の 人 は"
    },
    {
      "start": 1078.96,
      "end": 1083.96,
      "text": "インターネット で 服 を 買わ ない 一番 の 理由 は 何 だ と 言っ て い ます か"
    },
    {
      "start": 1099.46,
      "end": 1100.46,
      "text": "6番"
    },
    {
      "start": 1100.96,
      "end": 1103.46,
      "text": "街 の 体育 館 の 受付 で"
    },
    {
      "start": 1103.96,
      "end": 1106.96,
      "text": "男 の 人 と 係り の 人 が 話し て い ます"
    },
    {
      "start": 1107.96,
      "end": 1110.46,
      "text": "男 の 人 は どう し て 今日"
    },
    {
      "start": 1110.96,
      "end": 1112.96,
      "text": "利用 の 申し込み が でき ませ ん か"
    },
    {
      "start": 1137.26,
      "end": 1142.26,
      "text": "あの 初めて 体育館 を 利用 する ん です けど 今日 申し込め ます か"
    },
    {
      "start": 1143.26,
      "end": 1146.26,
      "text": "来月 12 名 で バスケット ボール を し たい ん です"
    },
    {
      "start": 1147.26,
      "end": 1148.76,
      "text": "代表 の 方 です ね"
    },
    {
      "start": 1149.26,
      "end": 1151.26,
      "text": "あの この 町 の 方 です か"
    },
    {
      "start": 1151.76,
      "end": 1152.26,
      "text": "はい"
    },
    {
      "start": 1152.76,
      "end": 1156.26,
      "text": "じゃあ この 町 に 住ん で いる こと が わかる 証明書 と"
    },
    {
      "start": 1156.76,
      "end": 1160.26,
      "text": "あ それ から 今日 犯行 は あり ます か"
    },
    {
      "start": 1160.76,
      "end": 1162.26,
      "text": "はい えっと"
    },
    {
      "start": 1162.76,
      "end": 1165.26,
      "text": "証明書 は 運転 免許書 で いい です か"
    },
    {
      "start": 1165.76,
      "end": 1166.76,
      "text": "大丈夫 です"
    },
    {
      "start": 1167.26,
      "end": 1167.76,
      "text": "えー"
    },
    {
      "start": 1168.26,
      "end": 1172.26,
      "text": "では この 申請 用紙 に 必要 な こと を 書い て ください"
    },
    {
      "start": 1173.26,
      "end": 1176.26,
      "text": "利用 者 の 名前 も 全員 文 お 願い し ます"
    },
    {
      "start": 1176.76,
      "end": 1179.76,
      "text": "あ みんな の 文 は 今 ちょっと"
    },
    {
      "start": 1180.76,
      "end": 1182.26,
      "text": "全員 文 必要 です か"
    },
    {
      "start": 1182.76,
      "end": 1183.26,
      "text": "はい"
    },
    {
      "start": 1183.76,
      "end": 1186.76,
      "text": "じゃあ 確認 し て 明日 また き ます"
    },
    {
      "start": 1187.26,
      "end": 1187.76,
      "text": "すみません"
    },
    {
      "start": 1187.76,
      "end": 1188.26,
      "text": "ねっ"
    },
    {
      "start": 1188.76,
      "end": 1191.26,
      "text": "では この 用紙 を 渡し ます から"
    },
    {
      "start": 1191.76,
      "end": 1194.76,
      "text": "これ に 書い て 犯行 を し て おもち ください"
    },
    {
      "start": 1195.76,
      "end": 1199.76,
      "text": "利用 料金 は その 時 現金 で お 支払い ください"
    },
    {
      "start": 1200.26,
      "end": 1201.76,
      "text": "よろしく お 願い し ます"
    },
    {
      "start": 1207.51,
      "end": 1213.01,
      "text": "男 の 人 は どう し て 今日 利用 の 申込み が できません か"
    },
    {
      "start": 1228.52,
      "end": 1229.52,
      "text": "一番"
    },
    {
      "start": 1230.02,
      "end": 1235.02,
      "text": "テレビ で 女 の アナウンサー と 男 の 人 が 話し て い ます"
    },
    {
      "start": 1236.76,
      "end": 1240.26,
      "text": "佐藤 さん は 子取 を 買っ て いらっしゃる そう です ね"
    },
    {
      "start": 1240.76,
      "end": 1242.76,
      "text": "ええ シロ と いう 名前 な ん です"
    },
    {
      "start": 1243.26,
      "end": 1245.26,
      "text": "いつ ごろ から 買っ て いらっしゃる ん です か"
    },
    {
      "start": 1245.76,
      "end": 1246.76,
      "text": "2 年前 です"
    },
    {
      "start": 1247.26,
      "end": 1251.26,
      "text": "長男 が 4 歳 の 時 自分 で 世話 を する と いう 約束 で"
    },
    {
      "start": 1252.26,
      "end": 1256.26,
      "text": "最初 は 大変 か と 思っ た ん です が キチン と 世話 を 続け て い ます"
    },
    {
      "start": 1257.26,
      "end": 1261.26,
      "text": "生き物 を 大切 に する 気持ち を 持っ て くれ て いる よう で 嬉しい です"
    },
    {
      "start": 1261.76,
      "end": 1265.26,
      "text": "小さい お子 さん で も 世話 が できる ん です ね"
    },
    {
      "start": 1265.76,
      "end": 1271.76,
      "text": "ええ 爪 を 切る と か そう いう こと は 子供 に は 難しい ん で 私 が し ます けど ね"
    },
    {
      "start": 1272.76,
      "end": 1277.26,
      "text": "それ から シロ を 買う よう に なっ て から 家族 の 会話 も 増え た 気 が し ます"
    },
    {
      "start": 1277.76,
      "end": 1278.76,
      "text": "そう です か"
    },
    {
      "start": 1279.26,
      "end": 1283.76,
      "text": "幼稚園 など で 家族 の 絵 を 描く 時 に は 必ず シロ も 入っ て いる ん です よ"
    },
    {
      "start": 1284.26,
      "end": 1286.26,
      "text": "シロ も 家族 な ん です ね"
    },
    {
      "start": 1286.76,
      "end": 1287.76,
      "text": "そうですね"
    },
    {
      "start": 1288.26,
      "end": 1292.76,
      "text": "私たち が シロ と 名前 を 呼ぶ と いつ も 可愛い 声 で 答える ん です"
    },
    {
      "start": 1293.26,
      "end": 1302.48,
      "text": "男 の 人 は 何 に つい て 話し て い ます か"
    },
    {
      "start": 1304.23,
      "end": 1305.23,
      "text": "一"
    },
    {
      "start": 1305.73,
      "end": 1307.73,
      "text": "小鳥 の 世話 で 大変 な こと"
    },
    {
      "start": 1308.23,
      "end": 1311.5,
      "text": "二"
    },
    {
      "start": 1312.0,
      "end": 1314.0,
      "text": "小鳥 を 買っ て よかっ た こと"
    },
    {
      "start": 1314.5,
      "end": 1317.8,
      "text": "三"
    },
    {
      "start": 1318.3,
      "end": 1320.3,
      "text": "小鳥 に つけ た 名前 の 意味"
    },
    {
      "start": 1320.8,
      "end": 1324.01,
      "text": "四"
    },
    {
      "start": 1324.51,
      "end": 1327.01,
      "text": "小鳥 を 上手 に 買う 方法"
    },
    {
      "start": 1338.55,
      "end": 1339.55,
      "text": "二番"
    },
    {
      "start": 1340.05,
      "end": 1346.05,
      "text": "アパート の 前 で 女 の 人 と 隣 の 部屋 の 男 の 人 が 話し て い ます"
    },
    {
      "start": 1348.05,
      "end": 1350.05,
      "text": "中村 さん こんばん は"
    },
    {
      "start": 1350.55,
      "end": 1352.05,
      "text": "あ こんばん は"
    },
    {
      "start": 1352.05,
      "end": 1355.05,
      "text": "夕米 は お 友達 たくさん 来 て た の ね"
    },
    {
      "start": 1355.55,
      "end": 1357.05,
      "text": "にぎやか でし た ね"
    },
    {
      "start": 1357.55,
      "end": 1360.05,
      "text": "あ はい 昨日 は パーティー で"
    },
    {
      "start": 1360.55,
      "end": 1365.05,
      "text": "でも 皆さん ちょっと声 が 大きく て 私"
    },
    {
      "start": 1365.55,
      "end": 1368.05,
      "text": "夜 なかなか 眠れ なかっ た ん です よ"
    },
    {
      "start": 1368.55,
      "end": 1370.55,
      "text": "ああ すみません でし た"
    },
    {
      "start": 1371.05,
      "end": 1374.05,
      "text": "いいえ パーティーって 楽しい です よ ね"
    },
    {
      "start": 1374.05,
      "end": 1379.05,
      "text": "私 も 若い 頃 友達 と よく パーティー し て た から わかる ん です"
    },
    {
      "start": 1379.55,
      "end": 1382.05,
      "text": "外国 に 住ん で い た 時 な ん です けど ね"
    },
    {
      "start": 1383.05,
      "end": 1385.05,
      "text": "パーティー を する の は いい ん です けど"
    },
    {
      "start": 1385.55,
      "end": 1387.55,
      "text": "ただ 時間 が ね"
    },
    {
      "start": 1388.05,
      "end": 1390.05,
      "text": "はい 気 を つけ ます"
    },
    {
      "start": 1390.55,
      "end": 1392.55,
      "text": "外国 に 住ん で いらっしゃっ た ん です か"
    },
    {
      "start": 1393.05,
      "end": 1395.55,
      "text": "よかったら 今度 話 を 聞か せ て ください"
    },
    {
      "start": 1396.55,
      "end": 1398.55,
      "text": "ええ また 今度 ね"
    },
    {
      "start": 1399.05,
      "end": 1407.3,
      "text": "女 の 人 が 言い たい こと は な ん です か"
    },
    {
      "start": 1409.3,
      "end": 1409.8,
      "text": "1"
    },
    {
      "start": 1410.8,
      "end": 1412.8,
      "text": "パーティー に 招待 し て ほしい"
    },
    {
      "start": 1415.57,
      "end": 1416.07,
      "text": "2"
    },
    {
      "start": 1417.07,
      "end": 1419.07,
      "text": "部屋 で パーティー を し ない で ほしい"
    },
    {
      "start": 1422.38,
      "end": 1422.88,
      "text": "3"
    },
    {
      "start": 1423.88,
      "end": 1426.38,
      "text": "外国 に いた 時 の 話 を 聞い て ほしい"
    },
    {
      "start": 1429.58,
      "end": 1430.08,
      "text": "4"
    },
    {
      "start": 1431.08,
      "end": 1433.08,
      "text": "夜 おそく に 騒が ない で ほしい"
    },
    {
      "start": 1445.19,
      "end": 1446.19,
      "text": "3番"
    },
    {
      "start": 1446.69,
      "end": 1449.69,
      "text": "ラジオ で 女 の 人 が 話し て い ます"
    },
    {
      "start": 1450.19,
      "end": 1453.53,
      "text": "寒く なっ て き まし た ね"
    },
    {
      "start": 1454.53,
      "end": 1457.53,
      "text": "冬 は インフル エンザ が 流行 する 季節 です"
    },
    {
      "start": 1458.53,
      "end": 1460.53,
      "text": "これは ウイルス が 原因 です"
    },
    {
      "start": 1462.03,
      "end": 1466.53,
      "text": "インフル エンザ は 1 年 中 いつ で も 掛かる 可能性 が あり ます が"
    },
    {
      "start": 1467.53,
      "end": 1473.03,
      "text": "特に 流行 する 冬 は 普段 から 手洗い や うがい を きちんと 行い"
    },
    {
      "start": 1473.53,
      "end": 1477.53,
      "text": "ウイルス を 体 の 中 に 取り込ま ない よう に する こと が 大切 です"
    },
    {
      "start": 1479.03,
      "end": 1481.53,
      "text": "また 生活 週刊 を 意識 し"
    },
    {
      "start": 1482.03,
      "end": 1484.53,
      "text": "規則 正しい 生活 を 送る と"
    },
    {
      "start": 1484.53,
      "end": 1489.03,
      "text": "ウイルス に 対する 体 の 力 が 強く なる こと が 期待 でき ます"
    },
    {
      "start": 1489.53,
      "end": 1498.78,
      "text": "女 の 人 は 何 に つい て 話し て い ます か"
    },
    {
      "start": 1500.28,
      "end": 1500.78,
      "text": "1"
    },
    {
      "start": 1501.78,
      "end": 1504.28,
      "text": "冬 に 病気 が 流行 する 理由"
    },
    {
      "start": 1504.78,
      "end": 1507.49,
      "text": "2"
    },
    {
      "start": 1508.49,
      "end": 1510.49,
      "text": "インフル エンザ の 直し方"
    },
    {
      "start": 1510.99,
      "end": 1513.79,
      "text": "3"
    },
    {
      "start": 1514.79,
      "end": 1517.29,
      "text": "生活 週刊 が 原因 の 病気"
    },
    {
      "start": 1517.79,
      "end": 1520.5,
      "text": "4"
    },
    {
      "start": 1521.5,
      "end": 1524.0,
      "text": "ウイルス から 体 を 守る 方法"
    },
    {
      "start": 1536.01,
      "end": 1536.51,
      "text": "1番"
    },
    {
      "start": 1537.51,
      "end": 1540.51,
      "text": "机 の 上 に 友達 の 傘 が あり ます"
    },
    {
      "start": 1541.51,
      "end": 1544.51,
      "text": "友達 は 今 帰る ところ です"
    },
    {
      "start": 1545.51,
      "end": 1547.01,
      "text": "何 と 言い ます か"
    },
    {
      "start": 1548.51,
      "end": 1549.01,
      "text": "1"
    },
    {
      "start": 1550.01,
      "end": 1551.51,
      "text": "傘 忘れてる よ"
    },
    {
      "start": 1552.01,
      "end": 1553.79,
      "text": "2"
    },
    {
      "start": 1554.79,
      "end": 1556.79,
      "text": "傘 持っ て こなかっ た の"
    },
    {
      "start": 1557.29,
      "end": 1559.07,
      "text": "3"
    },
    {
      "start": 1560.07,
      "end": 1562.07,
      "text": "傘 ここ に おい たら"
    },
    {
      "start": 1575.66,
      "end": 1576.16,
      "text": "2番"
    },
    {
      "start": 1577.16,
      "end": 1579.16,
      "text": "写真 を 撮っ て ほしい です"
    },
    {
      "start": 1580.16,
      "end": 1583.16,
      "text": "近く に いる 人 に 何 と 言い ます か"
    },
    {
      "start": 1585.16,
      "end": 1585.66,
      "text": "1"
    },
    {
      "start": 1586.66,
      "end": 1589.66,
      "text": "すみません 写真 を 撮っ て いただけ ませ ん か"
    },
    {
      "start": 1591.66,
      "end": 1592.16,
      "text": "2"
    },
    {
      "start": 1593.16,
      "end": 1596.16,
      "text": "あの 写真 を 撮っ て も よろしい です か"
    },
    {
      "start": 1597.97,
      "end": 1598.47,
      "text": "3"
    },
    {
      "start": 1599.47,
      "end": 1602.47,
      "text": "よけれ ば 写真 を おとり し ましょう か"
    },
    {
      "start": 1616.09,
      "end": 1616.59,
      "text": "3番"
    },
    {
      "start": 1617.59,
      "end": 1619.59,
      "text": "おしゃれ な 店 を 見つけ まし た"
    },
    {
      "start": 1620.59,
      "end": 1623.59,
      "text": "友達 を 誘っ て 一緒 に 入り たい です"
    },
    {
      "start": 1624.59,
      "end": 1626.59,
      "text": "何 と 言い ます か"
    },
    {
      "start": 1628.09,
      "end": 1628.59,
      "text": "1"
    },
    {
      "start": 1629.59,
      "end": 1631.59,
      "text": "ここ 行かなきゃ いけ ない"
    },
    {
      "start": 1633.59,
      "end": 1634.09,
      "text": "2"
    },
    {
      "start": 1634.59,
      "end": 1637.09,
      "text": "ここ この 前 入っ た よ ね"
    },
    {
      "start": 1637.59,
      "end": 1639.4,
      "text": "3"
    },
    {
      "start": 1640.4,
      "end": 1642.4,
      "text": "ここ ちょっと 見て いか ない"
    },
    {
      "start": 1642.9,
      "end": 1656.89,
      "text": "4番"
    },
    {
      "start": 1657.89,
      "end": 1661.89,
      "text": "辞書 を 忘れ た の で 友達 の 辞書 を 借り たい です"
    },
    {
      "start": 1662.89,
      "end": 1664.89,
      "text": "何 と 言い ます か"
    },
    {
      "start": 1665.89,
      "end": 1666.89,
      "text": "1"
    },
    {
      "start": 1667.39,
      "end": 1669.89,
      "text": "ぜひ その辞書 使っ て"
    },
    {
      "start": 1671.39,
      "end": 1671.89,
      "text": "2"
    },
    {
      "start": 1672.39,
      "end": 1675.89,
      "text": "その辞書 ちょっと 使わ せ て もらっ て も いい"
    },
    {
      "start": 1677.7,
      "end": 1678.2,
      "text": "3"
    },
    {
      "start": 1678.7,
      "end": 1681.2,
      "text": "その辞書 使っ て みる と いい よ"
    },
    {
      "start": 1694.76,
      "end": 1695.76,
      "text": "1番"
    },
    {
      "start": 1696.26,
      "end": 1699.26,
      "text": "いらっしゃいませ 何 名 さま でしょう か"
    },
    {
      "start": 1699.76,
      "end": 1702.01,
      "text": "1"
    },
    {
      "start": 1702.51,
      "end": 1704.01,
      "text": "6 回 目 です"
    },
    {
      "start": 1705.51,
      "end": 1706.01,
      "text": "2"
    },
    {
      "start": 1706.01,
      "end": 1708.01,
      "text": "6 人 です"
    },
    {
      "start": 1709.92,
      "end": 1710.42,
      "text": "3"
    },
    {
      "start": 1710.92,
      "end": 1712.42,
      "text": "お客さま です"
    },
    {
      "start": 1723.96,
      "end": 1724.46,
      "text": "2番"
    },
    {
      "start": 1725.46,
      "end": 1729.46,
      "text": "森 さん ちょっと 書類 の 整理 を 手伝っ て ほしい ん だ けど"
    },
    {
      "start": 1731.46,
      "end": 1731.96,
      "text": "1"
    },
    {
      "start": 1732.46,
      "end": 1735.46,
      "text": "そう もう 手伝わ なく て も いい の"
    },
    {
      "start": 1737.46,
      "end": 1737.96,
      "text": "2"
    },
    {
      "start": 1738.96,
      "end": 1741.46,
      "text": "ありがとう じゃあ お 願い する ね"
    },
    {
      "start": 1743.8,
      "end": 1744.3,
      "text": "3"
    },
    {
      "start": 1746.21,
      "end": 1747.71,
      "text": "少し あと なら できる けど"
    },
    {
      "start": 1759.28,
      "end": 1760.28,
      "text": "3番"
    },
    {
      "start": 1761.28,
      "end": 1764.78,
      "text": "鈴木 さん 今日は お 目 に 書か れ て 嬉し かっ た です"
    },
    {
      "start": 1766.78,
      "end": 1767.28,
      "text": "1"
    },
    {
      "start": 1767.78,
      "end": 1770.28,
      "text": "こちら こそ また お 会い し たい です"
    },
    {
      "start": 1772.28,
      "end": 1772.78,
      "text": "2"
    },
    {
      "start": 1773.78,
      "end": 1775.78,
      "text": "私 も 楽しみ に し て おり ます"
    },
    {
      "start": 1777.59,
      "end": 1778.09,
      "text": "3"
    },
    {
      "start": 1779.09,
      "end": 1781.09,
      "text": "では どうぞ ご覧 ください"
    },
    {
      "start": 1792.6,
      "end": 1793.6,
      "text": "4番"
    },
    {
      "start": 1794.6,
      "end": 1795.6,
      "text": "林 さん"
    },
    {
      "start": 1796.1,
      "end": 1800.1,
      "text": "日本語 ずいぶん うまく なっ て き たし スピーチ 大会 に 出 て み たら"
    },
    {
      "start": 1801.1,
      "end": 1801.6,
      "text": "1"
    },
    {
      "start": 1802.6,
      "end": 1805.6,
      "text": "じゃあ 出る の は 諦め ます"
    },
    {
      "start": 1806.1,
      "end": 1807.88,
      "text": "2"
    },
    {
      "start": 1808.38,
      "end": 1811.88,
      "text": "はい 私 も 出 て み たい と 思っ てる ん です"
    },
    {
      "start": 1812.38,
      "end": 1812.88,
      "text": "3"
    },
    {
      "start": 1815.19,
      "end": 1817.19,
      "text": "出 て み たら いかが です か"
    },
    {
      "start": 1817.69,
      "end": 1829.3,
      "text": "5番"
    },
    {
      "start": 1830.3,
      "end": 1834.3,
      "text": "あ 松本くん シャツ の ボタン が 取れ そう だ よ"
    },
    {
      "start": 1835.8,
      "end": 1836.8,
      "text": "1"
    },
    {
      "start": 1837.3,
      "end": 1839.3,
      "text": "どこ で 落とし ちゃっ た ん だろう"
    },
    {
      "start": 1839.8,
      "end": 1841.61,
      "text": "2"
    },
    {
      "start": 1842.61,
      "end": 1845.11,
      "text": "ほんと だ 全然 気 が つか なかっ た よ"
    },
    {
      "start": 1847.48,
      "end": 1847.98,
      "text": "3"
    },
    {
      "start": 1848.48,
      "end": 1850.48,
      "text": "拾っ て くれ た の ありが と"
    },
    {
      "start": 1862.52,
      "end": 1863.52,
      "text": "6番"
    },
    {
      "start": 1864.02,
      "end": 1869.02,
      "text": "先輩 さっき いただい た 資料 の こと で お 聞き し たい こと が ある ん です が"
    },
    {
      "start": 1871.27,
      "end": 1871.77,
      "text": "1"
    },
    {
      "start": 1872.77,
      "end": 1873.77,
      "text": "どこ で 聞い た の"
    },
    {
      "start": 1875.52,
      "end": 1876.02,
      "text": "2"
    },
    {
      "start": 1877.02,
      "end": 1878.52,
      "text": "どの 資料 が 欲しい の"
    },
    {
      "start": 1880.36,
      "end": 1880.86,
      "text": "3"
    },
    {
      "start": 1881.86,
      "end": 1883.36,
      "text": "うん どんな こと"
    },
    {
      "start": 1894.9,
      "end": 1895.9,
      "text": "7番"
    },
    {
      "start": 1896.4,
      "end": 1900.9,
      "text": "お料理 冷め ない うち に どうぞ お 飯 あがっ て ください"
    },
    {
      "start": 1902.65,
      "end": 1903.15,
      "text": "1"
    },
    {
      "start": 1904.15,
      "end": 1904.65,
      "text": "はい"
    },
    {
      "start": 1905.15,
      "end": 1906.65,
      "text": "では さっそく いただき ます"
    },
    {
      "start": 1907.15,
      "end": 1908.9,
      "text": "2"
    },
    {
      "start": 1909.9,
      "end": 1912.4,
      "text": "では 冷め て から いただく ん です ね"
    },
    {
      "start": 1912.9,
      "end": 1915.21,
      "text": "3"
    },
    {
      "start": 1915.71,
      "end": 1917.71,
      "text": "冷たい うち に いただき ます"
    },
    {
      "start": 1918.21,
      "end": 1930.38,
      "text": "8番"
    },
    {
      "start": 1930.88,
      "end": 1935.88,
      "text": "あ アパート の 部屋 の 鍵 かけ ず に 出 て きちゃっ た か も しれ ない"
    },
    {
      "start": 1937.38,
      "end": 1938.38,
      "text": "1"
    },
    {
      "start": 1938.88,
      "end": 1940.88,
      "text": "部屋 に 忘れ もの しちゃっ た の"
    },
    {
      "start": 1941.38,
      "end": 1943.13,
      "text": "2"
    },
    {
      "start": 1944.13,
      "end": 1946.63,
      "text": "帰っ て 確かめ た 方 が いい ん じゃ ない"
    },
    {
      "start": 1948.47,
      "end": 1948.97,
      "text": "3"
    },
    {
      "start": 1949.47,
      "end": 1951.97,
      "text": "かけ て き た ん なら 大丈夫 だ ね"
    },
    {
      "start": 1963.58,
      "end": 1964.58,
      "text": "9番"
    },
    {
      "start": 1965.08,
      "end": 1972.58,
      "text": "棚 の 片付け まだ 終わっ て ない みたい だ けど 遅い し それ 明日 に し て も 構わ ない よ"
    },
    {
      "start": 1974.08,
      "end": 1975.08,
      "text": "1"
    },
    {
      "start": 1975.58,
      "end": 1978.58,
      "text": "あ 教授 に 終わらせ ない と いけ ない ん です ね"
    },
    {
      "start": 1980.82,
      "end": 1981.32,
      "text": "2"
    },
    {
      "start": 1981.82,
      "end": 1984.32,
      "text": "今日は ちょっと お 手伝い でき ない ん です が"
    },
    {
      "start": 1984.82,
      "end": 1987.14,
      "text": "3"
    },
    {
      "start": 1987.64,
      "end": 1991.14,
      "text": "すみません じゃあ 今日は ここ まで に し ます"
    }
  ]
}
