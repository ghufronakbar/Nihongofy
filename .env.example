# COMMON
APP_URL=http://localhost:3000

# SESSION
SESSION_SECRET=

# DATABASE 
DATABASE_URL=
DIRECT_URL=

# CLOUDFLARE R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# REDIS
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=nihongofy

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# VERCEL CRON
CRON_SECRET=

# CLOUDFLARE TURNSTILE
# Site key dikirim ke browser; secret key hanya digunakan oleh server.
CLOUDFLARE_TURNSTILE_SITEKEY=
CLOUDFLARE_TURNSTILE_SECRETKEY=

# GOOGLE OAUTH
# Callback lokal: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FEATURE FLAGS
# "true" = modul tersedia, "false" = route 404 dan menu/link disembunyikan.
# Kosong atau tidak diisi = true. FEATURES_SPEAKING ikut mati bila
# FEATURES_CONVERSATION=false. Ubah lalu restart/redeploy aplikasi.
FEATURES_KANA=true
FEATURES_FLASHCARD=true
FEATURES_PRACTICE=true
FEATURES_TEST_PACKAGE=true
FEATURES_HISTORY=true
FEATURES_PROGRESS=true
FEATURES_ANALYTICS=true
FEATURES_ARTICLE=true
FEATURES_QUESTION_COMMENT=true
FEATURES_QUESTION_DISCUSSION=true
FEATURES_REPORT=true
FEATURES_CONVERSATION=true
FEATURES_SPEAKING=true

# CONVERSATION
# CONVERSATION_PROVIDER=mock hanya boleh di environment non-produksi; deployment
# produksi dengan FEATURES_CONVERSATION=true wajib memakai openai + OPENAI_API_KEY.
# OPENAI_BASE_URL kosong = API OpenAI resmi; isi URL 9Router untuk lewat gateway.
CONVERSATION_PROVIDER=
CONVERSATION_CHAT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# QUESTION EXPLANATION
# Generator pembahasan soal (prisma/generate-question-explanation.mjs). Hanya
# dipakai script offline, tidak dibaca aplikasi saat runtime.
EXPLANATION_BASE_URL=https://9router.lans.my.id/v1
EXPLANATION_API_KEY=
EXPLANATION_MODEL=
# EXPLANATION_VISION_MODEL wajib diisi agar soal bergambar diproses; bila kosong,
# soal tersebut dilewati alih-alih dijelaskan tanpa melihat gambarnya.
EXPLANATION_VISION_MODEL=
