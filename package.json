    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "prisma": "^6.19.3",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
