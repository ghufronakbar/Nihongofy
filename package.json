{
  "name": "jlpt-exam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "seed:flashcard-deck": "node --env-file-if-exists=.env prisma/seed-flashcard-deck.mjs",
    "seed:flashcard-deck:check": "node --env-file-if-exists=.env prisma/seed-flashcard-deck.mjs --validate-only",
    "seed:articles": "node --env-file-if-exists=.env prisma/seed-articles.mjs",
    "seed:test-package": "node --env-file-if-exists=.env prisma/seed-test-package.mjs",
    "seed:test-package:check": "node --env-file-if-exists=.env prisma/seed-test-package.mjs --validate-only",
    "seed:demo-test-package": "node --env-file-if-exists=.env prisma/seed-demo-test-package.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@shadcn/react": "^0.2.1",
    "@upstash/redis": "1.38.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "nodemailer": "9.1.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
