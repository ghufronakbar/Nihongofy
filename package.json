{
  "name": "nihongofy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "flashcard:extract": "node prisma/extract-flashcard-anki.mjs",
    "gen:flashcard": "node --env-file-if-exists=.env prisma/generate-flashcard-vocab.mjs",
    "flashcard:doubts": "node prisma/report-flashcard-doubts.mjs",
    "fix:flashcard-doubts": "node --env-file-if-exists=.env prisma/fix-flashcard-doubts.mjs",
    "seed:flashcard": "node --env-file-if-exists=.env prisma/seed-flashcard.mjs",
    "seed:flashcard:check": "node --env-file-if-exists=.env prisma/seed-flashcard.mjs --validate-only",
    "bunpou:extract": "node --env-file-if-exists=.env prisma/extract-bunpou.mjs",
    "gen:bunpou": "node --env-file-if-exists=.env prisma/generate-bunpou-content.mjs",
    "gen:bunpou-comparisons": "node --env-file-if-exists=.env prisma/generate-bunpou-comparisons.mjs",
    "bunpou:doubts": "node prisma/report-bunpou-doubts.mjs",
    "seed:bunpou": "node --env-file-if-exists=.env prisma/seed-bunpou.mjs",
    "seed:bunpou:check": "node --env-file-if-exists=.env prisma/seed-bunpou.mjs --validate-only",
    "seed:articles": "node --env-file-if-exists=.env prisma/seed-articles.mjs",
    "seed:test-package": "node --env-file-if-exists=.env prisma/seed-test-package.mjs",
    "seed:test-package:check": "node --env-file-if-exists=.env prisma/seed-test-package.mjs --validate-only",
    "seed:question-content": "node --env-file-if-exists=.env prisma/seed-question-content.mjs",
    "seed:question-content:check": "node --env-file-if-exists=.env prisma/seed-question-content.mjs --validate-only",
    "seed:question-explanation": "node --env-file-if-exists=.env prisma/seed-question-explanation.mjs",
    "seed:question-explanation:check": "node --env-file-if-exists=.env prisma/seed-question-explanation.mjs --validate-only",
    "test-package:delete": "node --env-file-if-exists=.env prisma/delete-test-package.mjs",
    "user:role": "node --env-file-if-exists=.env prisma/set-user-role.mjs",
    "seed:demo-test-package": "node --env-file-if-exists=.env prisma/seed-demo-test-package.mjs",
    "gen:explanation": "node --env-file-if-exists=.env prisma/generate-question-explanation.mjs",
    "explanation:doubts": "node prisma/report-explanation-doubts.mjs",
    "fixture:lint": "node prisma/lint-test-package-data.mjs",
    "fixture:repair": "node --env-file-if-exists=.env prisma/repair-test-package-data.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
